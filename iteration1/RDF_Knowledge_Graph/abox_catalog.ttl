<https://example.org/uiuc-course-advisor/resource/course/CS426> a uca:Course ;
    rdfs:label "CS 426 Compiler Construction" ;
    uca:courseCode "CS 426" ;
    uca:courseCreditsMax 4.0 ;
    uca:courseCreditsMin 3.0 ;
    uca:courseDescription "Compiler structure, syntax analysis, syntax-directed translation, automatically constructed recognizers, semantic analysis, code generation, intermediate language, optimization techniques. 3 undergraduate hours. 3 or 4 graduate hours. Prerequisite: Credit or concurrent enrollment in CS 421." ;
