<https://example.org/uiuc-course-advisor/resource/course/CS411> a uca:Course ;
    rdfs:label "CS 411 Database Systems" ;
    uca:courseCode "CS 411" ;
    uca:courseCreditsMax 4.0 ;
    uca:courseCreditsMin 3.0 ;
    uca:courseDescription "Examination of the logical organization of databases: the entity-relationship model; the hierarchical, network, and relational data models and their languages. Functional dependencies and normal forms. Design, implementation, and optimization of query languages; security and integrity; concurrency control, and distributed database systems. 3 undergraduate hours. 3 or 4 graduate hours. Prerequisite: CS 225." ;
    uca:courseNumber 411 ;
    uca:courseTitle "Database Systems" ;
    uca:hasOffering <https://example.org/uiuc-course-advisor/resource/offering/CS411/2026-fa> ;
    uca:hasPrerequisiteExpression <https://example.org/uiuc-course-advisor/resource/prereq/CS411> ;
    uca:inDepartment <https://example.org/uiuc-course-advisor/resource/department/CS> ;
    uca:sourceURL "https://discovery.cs.illinois.edu/dataset/course-catalog/"^^xsd:anyURI .

<https://example.org/uiuc-course-advisor/resource/course/CS412> a uca:Course ;
    rdfs:label "CS 412 Introduction to Data Mining" ;
    uca:courseCode "CS 412" ;
    uca:courseCreditsMax 4.0 ;
    uca:courseCreditsMin 3.0 ;
    uca:courseDescription "Concepts, techniques, and systems of data warehousing and data mining. Design and implementation of data warehouse and on-line analytical processing (OLAP) systems; data mining concepts, methods, systems, implementations, and applications. 3 undergraduate hours. 3 or 4 graduate hours. Prerequisite: CS 225." ;
    uca:courseNumber 412 ;
    uca:courseTitle "Introduction to Data Mining" ;
    uca:hasOffering <https://example.org/uiuc-course-advisor/resource/offering/CS412/2026-fa> ;
    uca:hasPrerequisiteExpression <https://example.org/uiuc-course-advisor/resource/prereq/CS412> ;
    uca:inDepartment <https://example.org/uiuc-course-advisor/resource/department/CS> ;
    uca:sourceURL "https://discovery.cs.illinois.edu/dataset/course-catalog/"^^xsd:anyURI .

<https://example.org/uiuc-course-advisor/resource/course/CS422> a uca:Course ;
    rdfs:label "CS 422 Programming Language Design" ;
    uca:courseCode "CS 422" ;
    uca:courseCreditsMax 4.0 ;
    uca:courseCreditsMin 3.0 ;
    uca:courseDescription "Exploration of major language design paradigms using imperative and functional programming as unifying themes. Tools include both practical language processor construction and theoretical models. 3 undergraduate hours. 3 or 4 graduate hours. Prerequisite: CS 421." ;
    uca:courseNumber 422 ;
