<https://example.org/uiuc-course-advisor/resource/course/MATH502> a uca:Course ;
    rdfs:label "MATH 502 Commutative Algebra" ;
    uca:courseCode "MATH 502" ;
    uca:courseCreditsMax 4.0 ;
    uca:courseCreditsMin 4.0 ;
    uca:courseDescription "Commutative rings and modules, prime ideals, localization, noetherian rings, primary decomposition, integral extensions and Noether normalization, the Nullstellensatz, dimension, flatness, Hensel's lemma, graded rings, Hilbert polynomial, valuations, regular rings, singularities, unique factorization, homological dimension, depth, completion. Possible further topics: smooth and etale extensions, ramification, Cohen-Macaulay modules, complete intersections. Prerequisite: MATH 501 or consent of instructor." ;
    uca:courseNumber 502 ;
    uca:courseTitle "Commutative Algebra" ;
    uca:hasOffering <https://example.org/uiuc-course-advisor/resource/offering/MATH502/2026-fa> ;
    uca:hasPrerequisiteExpression <https://example.org/uiuc-course-advisor/resource/prereq/MATH502> ;
    uca:inDepartment <https://example.org/uiuc-course-advisor/resource/department/MATH> ;
    uca:sourceURL "https://discovery.cs.illinois.edu/dataset/course-catalog/"^^xsd:anyURI .

<https://example.org/uiuc-course-advisor/resource/course/MATH512> a uca:Course ;
    rdfs:label "MATH 512 Modern Algebraic Geometry" ;
    uca:courseCode "MATH 512" ;
    uca:courseCreditsMax 4.0 ;
    uca:courseCreditsMin 4.0 ;
    uca:courseDescription "An introduction to the tools and ideas of contemporary algebraic geometry, with particular focus on the language of schemes. Prerequisite: MATH 500, and one of MATH 510, MATH 511, or consent of instructor." ;
