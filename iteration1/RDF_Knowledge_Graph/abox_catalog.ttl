<https://example.org/uiuc-course-advisor/resource/course/PHYS246> a uca:Course ;
    rdfs:label "PHYS 246 An Introduction to Modern Computational Physics" ;
    uca:courseCode "PHYS 246" ;
    uca:courseCreditsMax 2.0 ;
    uca:courseCreditsMin 2.0 ;
    uca:courseDescription "Project-based course that explores computational algorithms to solve a selection of physics problems. Algorithmic methods include Monte Carlo, numerical integration, machine learning, and simulation of dynamical systems. Topics will be selected from application areas that include chaos, orbital motion, particle physics, quantum computation, climate and fluid dynamics. No prior programming experience is required. Approved for both Letter and S/U grading. Prerequisite: Concurrent enrollment in PHYS 225." ;
    uca:courseNumber 246 ;
    uca:courseTitle "An Introduction to Modern Computational Physics" ;
    uca:hasOffering <https://example.org/uiuc-course-advisor/resource/offering/PHYS246/2026-fa> ;
    uca:hasPrerequisiteExpression <https://example.org/uiuc-course-advisor/resource/prereq/PHYS246> ;
    uca:inDepartment <https://example.org/uiuc-course-advisor/resource/department/PHYS> ;
