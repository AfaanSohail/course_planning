<https://example.org/uiuc-course-advisor/resource/course/ECE211> a uca:Course ;
    rdfs:label "ECE 211 Analog Circuits & Systems" ;
    uca:courseCode "ECE 211" ;
    uca:courseCreditsMax 2.0 ;
    uca:courseCreditsMin 2.0 ;
    uca:courseDescription "Concepts from circuit and system analysis: linear systems; review of elementary circuit analysis; op amps; transient analysis; differential equation models of linear circuits and systems; Laplace transform. Credit is not given for both ECE 211 and ECE 210. Prerequisite: ECE 110 and PHYS 212; credit or concurrent registration in MATH 285 or MATH 286." ;
    uca:courseNumber 211 ;
    uca:courseTitle "Analog Circuits & Systems" ;
    uca:hasOffering <https://example.org/uiuc-course-advisor/resource/offering/ECE211/2026-fa> ;
    uca:hasPrerequisiteExpression <https://example.org/uiuc-course-advisor/resource/prereq/ECE211> ;
    uca:inDepartment <https://example.org/uiuc-course-advisor/resource/department/ECE> ;
    uca:sourceURL "https://discovery.cs.illinois.edu/dataset/course-catalog/"^^xsd:anyURI .

<https://example.org/uiuc-course-advisor/resource/course/ECE217> a uca:Course ;
    rdfs:label "ECE 217 Solar Car" ;
    uca:courseCode "ECE 217" ;
    uca:courseCreditsMax 1.0 ;
    uca:courseCreditsMin 1.0 ;
    uca:courseDescription "The course covers high-level aspects of the design, construction, analysis, and economics of solar-powered electric vehicles. Topics bridge a variety of engineering disciplines integrated together with business to present a cohesive overview highlighting complexities of solar-powered vehicles. Students gain hands-on experience working with the Solar Car Team to build the next solar car and learn early in their curriculum that a multidisciplinary understanding is essential to create complex systems. May be repeated in separate terms up to 2 hours. Prerequisite: ECE 110." ;
    uca:courseNumber 217 ;
    uca:courseTitle "Solar Car" ;
    uca:hasOffering <https://example.org/uiuc-course-advisor/resource/offering/ECE217/2026-fa> ;
    uca:hasPrerequisiteExpression <https://example.org/uiuc-course-advisor/resource/prereq/ECE217> ;
    uca:inDepartment <https://example.org/uiuc-course-advisor/resource/department/ECE> ;
    uca:sourceURL "https://discovery.cs.illinois.edu/dataset/course-catalog/"^^xsd:anyURI .

<https://example.org/uiuc-course-advisor/resource/course/ECE304> a uca:Course ;
    rdfs:label "ECE 304 Photonic Devices" ;
    uca:courseCode "ECE 304" ;
    uca:courseCreditsMax 3.0 ;
    uca:courseCreditsMin 3.0 ;
    uca:courseDescription "Introduction to active and passive photonic devices and applications; optical processes in semiconductor and dielectric materials including electrical junctions, light emission and absorption, and waveguide confinement; photonic components such as light emitting diodes, lasers, photodetectors, solar cells, liquid crystals, and optical fiber; optical information distribution networks and display applications. Prerequisite: PHYS 214." ;
    uca:courseNumber 304 ;
    uca:courseTitle "Photonic Devices" ;
    uca:hasOffering <https://example.org/uiuc-course-advisor/resource/offering/ECE304/2026-fa> ;
    uca:hasPrerequisiteExpression <https://example.org/uiuc-course-advisor/resource/prereq/ECE304> ;
    uca:inDepartment <https://example.org/uiuc-course-advisor/resource/department/ECE> ;
    uca:sourceURL "https://discovery.cs.illinois.edu/dataset/course-catalog/"^^xsd:anyURI .

<https://example.org/uiuc-course-advisor/resource/course/ECE311> a uca:Course ;
    rdfs:label "ECE 311 Digital Signal Processing Lab" ;
    uca:courseCode "ECE 311" ;
    uca:courseCreditsMax 1.0 ;
    uca:courseCreditsMin 1.0 ;
