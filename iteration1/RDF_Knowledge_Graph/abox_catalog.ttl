<https://example.org/uiuc-course-advisor/resource/course/IE300> a uca:Course ;
    rdfs:label "IE 300 Analysis of Data" ;
    uca:courseCode "IE 300" ;
    uca:courseCreditsMax 3.0 ;
    uca:courseCreditsMin 3.0 ;
    uca:courseDescription "Nature of probabilistic models for observed data; discrete and continuous distribution function models; inferences on universe parameters based on sample values; control charts, acceptance sampling, and measurement theory. Credit is not given towards graduation for both IE 300 and CEE 202; credit is also not given towards graduation for both IE 300 and BIOE 310. Prerequisite: MATH 241." ;
    uca:courseNumber 300 ;
    uca:courseTitle "Analysis of Data" ;
