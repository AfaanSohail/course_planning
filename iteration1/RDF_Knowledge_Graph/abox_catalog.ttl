<https://example.org/uiuc-course-advisor/resource/course/ECE385> a uca:Course ;
    rdfs:label "ECE 385 Digital Systems Laboratory" ;
    uca:courseCode "ECE 385" ;
    uca:courseCreditsMax 3.0 ;
    uca:courseCreditsMin 3.0 ;
    uca:courseDescription "Design, build, and test digital systems using transistor-transistor logic (TTL), SystemVerilog, and field-programmable gate arrays (FPGAs). Topics include combinational and sequential logic, storage elements, input/output and display, timing analysis, design tradeoffs, synchronous and asynchronous design methods, datapath and controller, microprocessor design, software/hardware co-design, and system-on-a-chip. Prerequisite: ECE 110 and ECE 220." ;
    uca:courseNumber 385 ;
    uca:courseTitle "Digital Systems Laboratory" ;
    uca:hasOffering <https://example.org/uiuc-course-advisor/resource/offering/ECE385/2026-fa> ;
    uca:hasPrerequisiteExpression <https://example.org/uiuc-course-advisor/resource/prereq/ECE385> ;
    uca:inDepartment <https://example.org/uiuc-course-advisor/resource/department/ECE> ;
    uca:sourceURL "https://discovery.cs.illinois.edu/dataset/course-catalog/"^^xsd:anyURI .

