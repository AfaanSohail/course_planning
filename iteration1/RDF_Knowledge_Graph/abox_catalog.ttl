<https://example.org/uiuc-course-advisor/resource/course/ECE427> a uca:Course ;
    rdfs:label "ECE 427 Advanced VLSI System Design" ;
    uca:courseCode "ECE 427" ;
    uca:courseCreditsMax 4.0 ;
    uca:courseCreditsMin 4.0 ;
    uca:courseDescription "Students will work in teams on a semester-long project to design and fabricate their own digital, analog, or mixed-signal chip using modern EDA tools. Each team will propose a design in the form of specifications, write an RTL (or equivalent) model for their chip and its components, design schematics, create a testing/debug strategy, and perform layout, integration, and verification of their chip. Final GDS files will be sent to foundry at the end of semester. 4 undergraduate hours. 4 graduate hours. Prerequisite: Prior experience in hardware design and layout. At least one of ECE 385 or ECE 411 or ECE 425 or ECE 482 or ECE 483." ;
    uca:courseNumber 427 ;
    uca:courseTitle "Advanced VLSI System Design" ;
    uca:hasOffering <https://example.org/uiuc-course-advisor/resource/offering/ECE427/2026-fa> ;
    uca:hasPrerequisiteExpression <https://example.org/uiuc-course-advisor/resource/prereq/ECE427> ;
    uca:inDepartment <https://example.org/uiuc-course-advisor/resource/department/ECE> ;
    uca:sourceURL "https://discovery.cs.illinois.edu/dataset/course-catalog/"^^xsd:anyURI .

