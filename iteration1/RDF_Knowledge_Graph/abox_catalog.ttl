<https://example.org/uiuc-course-advisor/resource/course/CS415> a uca:Course ;
    rdfs:label "CS 415 Game Development" ;
    uca:courseCode "CS 415" ;
    uca:courseCreditsMax 4.0 ;
    uca:courseCreditsMin 3.0 ;
    uca:courseDescription "A team and project-based course on the technical aspects of video game development and game engine internals: geometric modeling, game physics and AI, shader programming, real-time physically based rendering, and software engineering practices within the game industry. The central focus of the course is the development of a game by teams of 3 to 5 students. The course strongly emphasizes code development using a modern game engine. Students will gain skills necessary to develop games and to develop game engines. 3 undergraduate hours. 4 graduate hours. Prerequisite: CS 225." ;
    uca:courseNumber 415 ;
    uca:courseTitle "Game Development" ;
    uca:hasOffering <https://example.org/uiuc-course-advisor/resource/offering/CS415/2026-fa> ;
