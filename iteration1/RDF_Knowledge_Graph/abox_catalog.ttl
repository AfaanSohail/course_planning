<https://example.org/uiuc-course-advisor/resource/course/MATH500> a uca:Course ;
    rdfs:label "MATH 500 Abstract Algebra I" ;
    uca:courseCode "MATH 500" ;
    uca:courseCreditsMax 4.0 ;
    uca:courseCreditsMin 4.0 ;
    uca:courseDescription "Isomorphism theorems for groups. Group actions. Composition series. Jordan-Holder theorem. Solvable and nilpotent groups. Field extensions. Algebraic and transcendental extensions. Algebraic closures. Fundamental theorem of Galois theory, and applications. Modules over commutative rings. Structure of finitely generated modules over a principal ideal domain. Applications to finite Abelian groups and matrix canonical forms. Prerequisite: MATH 417 and MATH 418." ;
    uca:courseNumber 500 ;
    uca:courseTitle "Abstract Algebra I" ;
    uca:hasOffering <https://example.org/uiuc-course-advisor/resource/offering/MATH500/2026-fa> ;
    uca:hasPrerequisiteExpression <https://example.org/uiuc-course-advisor/resource/prereq/MATH500> ;
    uca:inDepartment <https://example.org/uiuc-course-advisor/resource/department/MATH> ;
    uca:sourceURL "https://discovery.cs.illinois.edu/dataset/course-catalog/"^^xsd:anyURI .

<https://example.org/uiuc-course-advisor/resource/course/MATH564> a uca:Course ;
    rdfs:label "MATH 564 Applied Stochastic Processes" ;
    uca:courseCode "MATH 564" ;
    uca:courseCreditsMax 4.0 ;
    uca:courseCreditsMin 4.0 ;
    uca:courseDescription "Introduction to topics such as spectral analysis, filtering theory, and prediction theory of stationary processes; Markov chains and Markov processes. Same as STAT 555. Prerequisite: MATH 446 and MATH 447." ;
    uca:courseNumber 564 ;
    uca:courseTitle "Applied Stochastic Processes" ;
    uca:crossListedWith <https://example.org/uiuc-course-advisor/resource/course/STAT555> ;
