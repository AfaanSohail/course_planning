<https://example.org/uiuc-course-advisor/resource/course/PHYS394> a uca:Course ;
    rdfs:label "PHYS 394 Pedagogy and Teaching Physics for Learning Assistants" ;
    uca:courseCode "PHYS 394" ;
    uca:courseCreditsMax 2.0 ;
    uca:courseCreditsMin 2.0 ;
    uca:courseDescription "Designed to support Learning Assistants (LAs) who are working as instructional aids in lab or discussion sections of the introductory physics courses. Students will study pedagogical strategies for instructor-student interaction and philosophies guiding lab design and/or discussion problem creation. Prerequisite: Instructor Approval Required. Lab LAs must have successfully completed PHYS 101, PHYS 102, PHYS 211, or PHYS 212. Discussion LAs must have successfully completed PHYS 100 and PHYS 211." ;
    uca:courseNumber 394 ;
    uca:courseTitle "Pedagogy and Teaching Physics for Learning Assistants" ;
    uca:hasOffering <https://example.org/uiuc-course-advisor/resource/offering/PHYS394/2026-fa> ;
