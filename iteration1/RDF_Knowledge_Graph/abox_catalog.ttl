<https://example.org/uiuc-course-advisor/resource/course/ECE420> a uca:Course ;
    rdfs:label "ECE 420 Embedded DSP Laboratory" ;
    uca:courseCode "ECE 420" ;
    uca:courseCreditsMax 2.0 ;
