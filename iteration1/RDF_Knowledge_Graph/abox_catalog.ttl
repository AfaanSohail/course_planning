<https://example.org/uiuc-course-advisor/resource/course/CS277> a uca:Course ;
    rdfs:label "CS 277 Algorithms and Data Structures for Data Science" ;
    uca:courseCode "CS 277" ;
    uca:courseCreditsMax 4.0 ;
    uca:courseCreditsMin 4.0 ;
    uca:courseDescription "Introduction to elementary concepts in algorithms and classical data structures with a focus on their applications in Data Science. Topics include algorithm analysis (ex: Big-O notation), elementary data structures (ex: lists, stacks, queues, trees, and graphs), basics of discrete algorithm design principles (ex: greedy, divide and conquer, dynamic programming), and discussion of discrete and continuous optimization. Credit is not given for CS 277 if credit for CS 225 is earned. Prerequisite: STAT 207; one of MATH 220, MATH 221, MATH 234. CS 277 cannot be taken concurrently with CS 225." ;
    uca:courseNumber 277 ;
    uca:courseTitle "Algorithms and Data Structures for Data Science" ;
    uca:hasOffering <https://example.org/uiuc-course-advisor/resource/offering/CS277/2026-fa> ;
    uca:hasPrerequisiteExpression <https://example.org/uiuc-course-advisor/resource/prereq/CS277> ;
    uca:inDepartment <https://example.org/uiuc-course-advisor/resource/department/CS> ;
    uca:sourceURL "https://discovery.cs.illinois.edu/dataset/course-catalog/"^^xsd:anyURI .

