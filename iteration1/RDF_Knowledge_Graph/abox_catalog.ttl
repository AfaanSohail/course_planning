<https://example.org/uiuc-course-advisor/resource/course/ECE534> a uca:Course ;
    rdfs:label "ECE 534 Random Processes" ;
    uca:courseCode "ECE 534" ;
    uca:courseCreditsMax 4.0 ;
    uca:courseCreditsMin 4.0 ;
    uca:courseDescription "Basic concepts of random processes; linear systems with random inputs; Markov processes; spectral analysis; Wiener and Kalman filtering; applications to systems engineering. Prerequisite: One of ECE 313, MATH 461, STAT 400." ;
