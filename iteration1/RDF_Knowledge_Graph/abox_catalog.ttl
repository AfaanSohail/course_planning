<https://example.org/uiuc-course-advisor/resource/course/ECE439> a uca:Course ;
    rdfs:label "ECE 439 Wireless Networks" ;
    uca:courseCode "ECE 439" ;
    uca:courseCreditsMax 4.0 ;
    uca:courseCreditsMin 3.0 ;
    uca:courseDescription "Overview of wireless network architectures including cellular networks, local area networks, multi-hop wireless networks such as ad hoc networks, mesh networks, and sensor networks; capacity of wireless networks; medium access control, routing protocols, and transport protocols for wireless networks; mechanisms to improve performance and security in wireless networks; energy-efficient protocols for sensor networks. Same as CS 439. 3 undergraduate hours. 3 or 4 graduate hours. Prerequisite: ECE 391; CS 241 or CS 341; one of MATH 461, MATH 463, ECE 313." ;
    uca:courseNumber 439 ;
    uca:courseTitle "Wireless Networks" ;
    uca:crossListedWith <https://example.org/uiuc-course-advisor/resource/course/CS439> ;
    uca:hasOffering <https://example.org/uiuc-course-advisor/resource/offering/ECE439/2026-fa> ;
