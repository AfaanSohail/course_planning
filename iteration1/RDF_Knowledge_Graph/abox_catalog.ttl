<https://example.org/uiuc-course-advisor/resource/course/ECE437> a uca:Course ;
    rdfs:label "ECE 437 Sensors and Instrumentation" ;
    uca:courseCode "ECE 437" ;
    uca:courseCreditsMax 3.0 ;
    uca:courseCreditsMin 3.0 ;
    uca:courseDescription "Hands-on exposure to fundamental technology and practical application of sensors. Capacitive, inductive, optical, electromagnetic, and other sensing methods are examined. Instrumentation techniques incorporating computer control, sampling, and data collection and analysis are reviewed in the context of real-world scenarios. 3 undergraduate hours. 3 graduate hours. Prerequisite: ECE 329." ;
    uca:courseNumber 437 ;
    uca:courseTitle "Sensors and Instrumentation" ;
    uca:hasOffering <https://example.org/uiuc-course-advisor/resource/offering/ECE437/2026-fa> ;
    uca:hasPrerequisiteExpression <https://example.org/uiuc-course-advisor/resource/prereq/ECE437> ;
    uca:inDepartment <https://example.org/uiuc-course-advisor/resource/department/ECE> ;
    uca:sourceURL "https://discovery.cs.illinois.edu/dataset/course-catalog/"^^xsd:anyURI .

<https://example.org/uiuc-course-advisor/resource/course/ECE441> a uca:Course ;
    rdfs:label "ECE 441 Physcs & Modeling Semicond Dev" ;
    uca:courseCode "ECE 441" ;
    uca:courseCreditsMax 3.0 ;
    uca:courseCreditsMin 3.0 ;
    uca:courseDescription "Advanced concepts including generation-recombination, hot electron effects, and breakdown mechanisms; essential features of small ac characteristics, switching and transient behavior of p-n junctions, and bipolar and MOS transistors; fundamental issues for device modeling; perspective and limitations of Si-devices. 3 undergraduate hours. 3 graduate hours. Prerequisite: ECE 340." ;
    uca:courseNumber 441 ;
    uca:courseTitle "Physcs & Modeling Semicond Dev" ;
    uca:hasOffering <https://example.org/uiuc-course-advisor/resource/offering/ECE441/2026-fa> ;
