<https://example.org/uiuc-course-advisor/resource/course/CS579> a uca:Course ;
    rdfs:label "CS 579 Computational Complexity" ;
    uca:courseCode "CS 579" ;
    uca:courseCreditsMax 4.0 ;
    uca:courseCreditsMin 4.0 ;
    uca:courseDescription "Turing machines; determinism and non-determinism; time and space hierarchy theorems; speed-up and tape compression; Blum axioms; structure of complexity classes NP, P, NL, L, and PSPACE; complete problems; randomness and complexity classes RP, RL, and BPP; alternation, polynomial-time hierarchy; circuit complexity, parallel complexity, NC, and RNC; relativized computational complexity; time-space trade-offs. Same as ECE 579. Prerequisite: One of CS 473, CSE 414, MATH 473, CS 475 or MATH 475." ;
    uca:courseNumber 579 ;
    uca:courseTitle "Computational Complexity" ;
    uca:crossListedWith <https://example.org/uiuc-course-advisor/resource/course/ECE579> ;
    uca:hasOffering <https://example.org/uiuc-course-advisor/resource/offering/CS579/2026-fa> ;
    uca:hasPrerequisiteExpression <https://example.org/uiuc-course-advisor/resource/prereq/CS579> ;
    uca:inDepartment <https://example.org/uiuc-course-advisor/resource/department/CS> ;
    uca:sourceURL "https://discovery.cs.illinois.edu/dataset/course-catalog/"^^xsd:anyURI .

