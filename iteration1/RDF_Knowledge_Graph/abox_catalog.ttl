<https://example.org/uiuc-course-advisor/resource/course/CS524> a uca:Course ;
    rdfs:label "CS 524 Concurrent Progrmg Languages" ;
    uca:courseCode "CS 524" ;
    uca:courseCreditsMax 4.0 ;
