<https://example.org/uiuc-course-advisor/resource/course/ECE329> a uca:Course ;
    rdfs:label "ECE 329 Fields and Waves I" ;
    uca:courseCode "ECE 329" ;
    uca:courseCreditsMax 3.0 ;
    uca:courseCreditsMin 3.0 ;
    uca:courseDescription "Electromagnetic fields and waves fundamentals and their engineering applications: static electric and magnetic fields; energy storage; Maxwell's equations for time-varying fields; wave solutions in free space, dielectrics and conducting media, transmission line systems; time- and frequency-domain analysis of transmission line circuits and Smith chart applications. Prerequisite: ECE 210." ;
    uca:courseNumber 329 ;
    uca:courseTitle "Fields and Waves I" ;
    uca:hasOffering <https://example.org/uiuc-course-advisor/resource/offering/ECE329/2026-fa> ;
