<https://example.org/uiuc-course-advisor/resource/course/PLPA200> a uca:Course ;
    rdfs:label "PLPA 200 Plants, Pathogens, and People" ;
    uca:courseCode "PLPA 200" ;
    uca:courseCreditsMax 3.0 ;
    uca:courseCreditsMin 3.0 ;
    uca:courseDescription "Plant diseases and their impact on food supplies and human history are studied in lectures, demonstrations and discussions. Issues of food production and safety, pesticide use and human health, and the environment are considered. Includes the biology of pathogens that cause plant disease. Designed for non-science and science majors. Prerequisite: RHET 105 or equivalent." ;
    uca:courseNumber 200 ;
    uca:courseTitle "Plants, Pathogens, and People" ;
    uca:hasDegreeAttribute "Advanced Composition, and Nat Sci & Tech - Life Sciences course." ;
