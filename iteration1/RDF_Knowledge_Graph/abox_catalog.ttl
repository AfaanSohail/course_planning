<https://example.org/uiuc-course-advisor/resource/course/GEOL107> a uca:Course ;
    rdfs:label "GEOL 107 Physical Geology" ;
    uca:courseCode "GEOL 107" ;
    uca:courseCreditsMax 4.0 ;
    uca:courseCreditsMin 4.0 ;
    uca:courseDescription "Introduces Earth phenomena and processes. Includes minerals and rocks, continental drift, plate tectonics, rock deformation, igneous and sedimentary processes, geologic time, landscape evolution, internal structure and composition of the earth, groundwater, seismology and earthquakes, and formation of natural resources. Emphasizes the chemical and physical aspects of the Earth, and the basis for geological inference. Field trip required. Additional fees may apply. See Class Schedule. Credit is not given for both GEOL 107 and GEOL 100, GEOL 101 or GEOL 103. Prerequisite: Intended for science and science-oriented students." ;
    uca:courseNumber 107 ;
    uca:courseTitle "Physical Geology" ;
    uca:hasDegreeAttribute "Nat Sci & Tech - Phys Sciences course." ;
    uca:hasOffering <https://example.org/uiuc-course-advisor/resource/offering/GEOL107/2026-fa> ;
    uca:hasPrerequisiteExpression <https://example.org/uiuc-course-advisor/resource/prereq/GEOL107> ;
    uca:inDepartment <https://example.org/uiuc-course-advisor/resource/department/GEOL> ;
    uca:sourceURL "https://discovery.cs.illinois.edu/dataset/course-catalog/"^^xsd:anyURI .

<https://example.org/uiuc-course-advisor/resource/course/GGIS103> a uca:Course ;
    rdfs:label "GGIS 103 Earth's Physical Systems" ;
    uca:courseCode "GGIS 103" ;
    uca:courseCreditsMax 4.0 ;
    uca:courseCreditsMin 4.0 ;
    uca:courseDescription "A basic introduction to the environmental systems of the Earth's surface, including landforms, soils, and ecosystems and how these systems are affected by global change. Emphasizes the importance of human-Earth relations and a holistic view of environmental systems. Same as ESE 103." ;
    uca:courseNumber 103 ;
    uca:courseTitle "Earth's Physical Systems" ;
    uca:hasDegreeAttribute "Nat Sci & Tech - Phys Sciences course." ;
    uca:hasOffering <https://example.org/uiuc-course-advisor/resource/offering/GGIS103/2026-fa> ;
    uca:inDepartment <https://example.org/uiuc-course-advisor/resource/department/GGIS> ;
    uca:sourceURL "https://discovery.cs.illinois.edu/dataset/course-catalog/"^^xsd:anyURI .

<https://example.org/uiuc-course-advisor/resource/course/IE310> a uca:Course ;
    rdfs:label "IE 310 Deterministic Models in Optimization" ;
    uca:courseCode "IE 310" ;
    uca:courseCreditsMax 3.0 ;
    uca:courseCreditsMin 3.0 ;
    uca:courseDescription "Linear Optimization - Simplex method, duality, and sensitivity analysis, Transportation and Assignment Problems, Network Optimization Models, Dynamic Programming, Nonlinear optimization, and Discrete optimization. Credit is not given for both IE 310 and CEE 201. Prerequisite: Credit or concurrent registration in MATH 257 or MATH 415." ;
    uca:courseNumber 310 ;
    uca:courseTitle "Deterministic Models in Optimization" ;
    uca:hasOffering <https://example.org/uiuc-course-advisor/resource/offering/IE310/2026-fa> ;
    uca:hasPrerequisiteExpression <https://example.org/uiuc-course-advisor/resource/prereq/IE310> ;
    uca:inDepartment <https://example.org/uiuc-course-advisor/resource/department/IE> ;
    uca:sourceURL "https://discovery.cs.illinois.edu/dataset/course-catalog/"^^xsd:anyURI .

<https://example.org/uiuc-course-advisor/resource/course/IE410> a uca:Course ;
    rdfs:label "IE 410 Advanced Topics in Stochastic Processes & Applications" ;
    uca:courseCode "IE 410" ;
    uca:courseCreditsMax 4.0 ;
    uca:courseCreditsMin 3.0 ;
    uca:courseDescription "Modeling and analysis of stochastic processes. Transient and steady-state behavior of continuous-time Markov chains; renewal processes; models of queuing systems (birth-and-death models, embedded-Markov-chain models, queuing networks); reliability models; inventory models. Familiarity with discrete-time Markov chains, Poisson processes, and birth-and-death processes is assumed. Same as CS 481. 3 undergraduate hours. 4 graduate hours. Prerequisite: IE 310." ;
    uca:courseNumber 410 ;
    uca:courseTitle "Advanced Topics in Stochastic Processes & Applications" ;
    uca:hasOffering <https://example.org/uiuc-course-advisor/resource/offering/IE410/2026-fa> ;
    uca:hasPrerequisiteExpression <https://example.org/uiuc-course-advisor/resource/prereq/IE410> ;
    uca:inDepartment <https://example.org/uiuc-course-advisor/resource/department/IE> ;
    uca:sourceURL "https://discovery.cs.illinois.edu/dataset/course-catalog/"^^xsd:anyURI .

<https://example.org/uiuc-course-advisor/resource/course/IE534> a uca:Course ;
    rdfs:label "IE 534 Deep Learning" ;
    uca:courseCode "IE 534" ;
    uca:courseCreditsMax 4.0 ;
    uca:courseCreditsMin 4.0 ;
    uca:courseDescription "Provides an introduction to neural networks and recent advances in deep learning. Topics include training and implementation of neural networks, convolution neural networks, recurrent neural networks (LSTM and gated recurrent), residual networks, reinforcement learning, and Q-learning with neural networks. A part of the course will especially focus on recent work in deep reinforcement learning. The course will also cover deep learning libraries (e.g., Chainer, Tensorflow) and how to train neural networks using GPUs and GPU clusters. Same as CS 547. Credit is not given for both IE 534 and IE 434. Prerequisite: CS 446 or equivalent. Graduate students only." ;
    uca:courseNumber 534 ;
    uca:courseTitle "Deep Learning" ;
    uca:hasOffering <https://example.org/uiuc-course-advisor/resource/offering/IE534/2026-fa> ;
    uca:hasPrerequisiteExpression <https://example.org/uiuc-course-advisor/resource/prereq/IE534> ;
    uca:inDepartment <https://example.org/uiuc-course-advisor/resource/department/IE> ;
    uca:sourceURL "https://discovery.cs.illinois.edu/dataset/course-catalog/"^^xsd:anyURI .

