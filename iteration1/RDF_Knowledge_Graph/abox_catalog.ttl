<https://example.org/uiuc-course-advisor/resource/course/STAT200> a uca:Course ;
    rdfs:label "STAT 200 Statistical Analysis" ;
    uca:courseCode "STAT 200" ;
    uca:courseCreditsMax 3.0 ;
    uca:courseCreditsMin 3.0 ;
    uca:courseDescription "Survey of statistical concepts, data analysis, designed and observational studies and statistical models. Statistical computing using a statistical package such as R or a spreadsheet. Topics to be covered include data summary and visualization, study design, elementary probability, categorical data, comparative experiments, multiple linear regression, analysis of variance, statistical inferences and model diagnostics. May be taken as a first statistics course for quantitatively oriented students, or as a second course to follow a basic concepts course. Credit is not given for both STAT 200 and STAT 212." ;
    uca:courseNumber 200 ;
    uca:courseTitle "Statistical Analysis" ;
    uca:hasDegreeAttribute "Quantitative Reasoning I course." ;
    uca:hasOffering <https://example.org/uiuc-course-advisor/resource/offering/STAT200/2026-fa> ;
    uca:inDepartment <https://example.org/uiuc-course-advisor/resource/department/STAT> ;
    uca:sourceURL "https://discovery.cs.illinois.edu/dataset/course-catalog/"^^xsd:anyURI .

<https://example.org/uiuc-course-advisor/resource/course/STAT212> a uca:Course ;
    rdfs:label "STAT 212 Biostatistics" ;
    uca:courseCode "STAT 212" ;
    uca:courseCreditsMax 3.0 ;
    uca:courseCreditsMin 3.0 ;
    uca:courseDescription "Application of statistical reasoning and statistical methodology to biology. Topics include descriptive statistics, graphical methods, experimental design, probability, statistical inference and regression. In addition, techniques of statistical computing are covered. Credit is not given for both STAT 212 and STAT 200." ;
    uca:courseNumber 212 ;
    uca:courseTitle "Biostatistics" ;
    uca:hasDegreeAttribute "Quantitative Reasoning I course." ;
    uca:hasOffering <https://example.org/uiuc-course-advisor/resource/offering/STAT212/2026-fa> ;
    uca:inDepartment <https://example.org/uiuc-course-advisor/resource/department/STAT> ;
    uca:sourceURL "https://discovery.cs.illinois.edu/dataset/course-catalog/"^^xsd:anyURI .

<https://example.org/uiuc-course-advisor/resource/course/STAT408> a uca:Course ;
    rdfs:label "STAT 408 Actuarial Statistics I" ;
    uca:courseCode "STAT 408" ;
    uca:courseCreditsMax 4.0 ;
    uca:courseCreditsMin 4.0 ;
    uca:courseDescription "Same as ASRM 401. See ASRM 401." ;
    uca:courseNumber 408 ;
    uca:courseTitle "Actuarial Statistics I" ;
    uca:crossListedWith <https://example.org/uiuc-course-advisor/resource/course/ASRM401> ;
    uca:hasOffering <https://example.org/uiuc-course-advisor/resource/offering/STAT408/2026-fa> ;
