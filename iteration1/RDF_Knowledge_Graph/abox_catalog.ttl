<https://example.org/uiuc-course-advisor/resource/course/MATH213> a uca:Course ;
    rdfs:label "MATH 213 Basic Discrete Mathematics" ;
    uca:courseCode "MATH 213" ;
    uca:courseCreditsMax 3.0 ;
    uca:courseCreditsMin 3.0 ;
    uca:courseDescription "[IAI Code: M1905] Beginning course on discrete mathematics, including sets and relations, functions, basic counting techniques, recurrence relations, graphs and trees, and matrix algebra; emphasis throughout is on algorithms and their efficacy. Credit is not given toward graduation for: Credit is not given for both MATH 213 and CS 173. Prerequisite: MATH 220 or MATH 221, or equivalent." ;
    uca:courseNumber 213 ;
    uca:courseTitle "Basic Discrete Mathematics" ;
    uca:hasDegreeAttribute "Quantitative Reasoning II course." ;
