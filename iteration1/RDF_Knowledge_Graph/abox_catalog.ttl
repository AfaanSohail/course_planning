<https://example.org/uiuc-course-advisor/resource/course/MATH526> a uca:Course ;
    rdfs:label "MATH 526 Algebraic Topology II" ;
    uca:courseCode "MATH 526" ;
    uca:courseCreditsMax 4.0 ;
    uca:courseCreditsMin 4.0 ;
    uca:courseDescription "CW-complexes, relative homeomorphism theorem, cellular homology, cohomology, Kunneth theorem, Eilenberg-Zilber theorem, cup products, Poincare duality, examples. Prerequisite: MATH 525, MATH 500; or consent of instructor. MATH 501 is recommended but not required." ;
    uca:courseNumber 526 ;
