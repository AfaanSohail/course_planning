<https://example.org/uiuc-course-advisor/resource/course/PHYS213> a uca:Course ;
    rdfs:label "PHYS 213 Univ Physics: Thermal Physics" ;
    uca:courseCode "PHYS 213" ;
    uca:courseCreditsMax 2.0 ;
    uca:courseCreditsMin 2.0 ;
    uca:courseDescription "First and second laws of thermodynamics including kinetic theory of gases, heat capacity, heat engines, introduction to entropy and statistical mechanics, and introduction to application of free energy and Boltzmann factor. A calculus-based approach for majors in engineering, mathematics, physics and chemistry. Credit is not given for both PHYS 213 and PHYS 101. Prerequisite: PHYS 211; credit or concurrent registration in MATH 241." ;
    uca:courseNumber 213 ;
    uca:courseTitle "Univ Physics: Thermal Physics" ;
    uca:hasOffering <https://example.org/uiuc-course-advisor/resource/offering/PHYS213/2026-fa> ;
    uca:hasPrerequisiteExpression <https://example.org/uiuc-course-advisor/resource/prereq/PHYS213> ;
    uca:inDepartment <https://example.org/uiuc-course-advisor/resource/department/PHYS> ;
    uca:sourceURL "https://discovery.cs.illinois.edu/dataset/course-catalog/"^^xsd:anyURI .

<https://example.org/uiuc-course-advisor/resource/course/PHYS436> a uca:Course ;
    rdfs:label "PHYS 436 Electromagnetic Fields II" ;
    uca:courseCode "PHYS 436" ;
    uca:courseCreditsMax 3.0 ;
    uca:courseCreditsMin 3.0 ;
    uca:courseDescription "Time-dependent fields. Electromagnetic induction, Maxwell's equations, electromagnetic wave propagation in various media and structures, and electromagnetic radiation from charge and current distributions. Relativistic covariance of Maxwell's equations.  undergraduate hours. 3 graduate hours. Prerequisite: PHYS 435." ;
    uca:courseNumber 436 ;
    uca:courseTitle "Electromagnetic Fields II" ;
    uca:hasOffering <https://example.org/uiuc-course-advisor/resource/offering/PHYS436/2026-fa> ;
    uca:hasPrerequisiteExpression <https://example.org/uiuc-course-advisor/resource/prereq/PHYS436> ;
    uca:inDepartment <https://example.org/uiuc-course-advisor/resource/department/PHYS> ;
    uca:sourceURL "https://discovery.cs.illinois.edu/dataset/course-catalog/"^^xsd:anyURI .

<https://example.org/uiuc-course-advisor/resource/course/RHET105> a uca:Course ;
    rdfs:label "RHET 105 Writing and Research" ;
    uca:courseCode "RHET 105" ;
    uca:courseCreditsMax 4.0 ;
    uca:courseCreditsMin 4.0 ;
    uca:courseDescription "[IAI Code: C1901R] Introduction in research-based writing and the construction of academic, argumentative essays that use primary and secondary sources as evidence. This course fulfills the Campus Composition I general education requirement. Credit is not given toward graduation for: Credit is not given for both RHET 105 and any of these other Comp I courses: RHET 101, RHET 102, CMN 111 or CMN 112." ;
    uca:courseNumber 105 ;
    uca:courseTitle "Writing and Research" ;
    uca:hasDegreeAttribute "Composition I course." ;
    uca:hasOffering <https://example.org/uiuc-course-advisor/resource/offering/RHET105/2026-fa> ;
    uca:inDepartment <https://example.org/uiuc-course-advisor/resource/department/RHET> ;
    uca:sourceURL "https://discovery.cs.illinois.edu/dataset/course-catalog/"^^xsd:anyURI .

<https://example.org/uiuc-course-advisor/resource/course/STAT107> a uca:Course ;
    rdfs:label "STAT 107 Data Science Discovery" ;
    uca:courseCode "STAT 107" ;
    uca:courseCreditsMax 4.0 ;
    uca:courseCreditsMin 4.0 ;
    uca:courseDescription "Data Science Discovery is the intersection of statistics, computation, and real-world relevance. As a project-driven course, students perform hands-on-analysis of real-world datasets to analyze and discover the impact of the data. Throughout each experience, students reflect on the social issues surrounding data analysis such as privacy and design. Same as CS 107 and IS 107." ;
    uca:courseNumber 107 ;
    uca:courseTitle "Data Science Discovery" ;
    uca:crossListedWith <https://example.org/uiuc-course-advisor/resource/course/CS107>,
        <https://example.org/uiuc-course-advisor/resource/course/IS107> ;
    uca:hasDegreeAttribute "Quantitative Reasoning I course." ;
    uca:hasOffering <https://example.org/uiuc-course-advisor/resource/offering/STAT107/2026-fa> ;
    uca:inDepartment <https://example.org/uiuc-course-advisor/resource/department/STAT> ;
    uca:sourceURL "https://discovery.cs.illinois.edu/dataset/course-catalog/"^^xsd:anyURI .

<https://example.org/uiuc-course-advisor/resource/course/STAT510> a uca:Course ;
    rdfs:label "STAT 510 Mathematical Statistics" ;
    uca:courseCode "STAT 510" ;
    uca:courseCreditsMax 4.0 ;
    uca:courseCreditsMin 4.0 ;
    uca:courseDescription "Provides a graduate level foundation in fundamental mathematical statistics topics including order statistics, exponential families, sufficiency, Rao-Blackwell theorem, Cramer-Rao lower bound, point estimation, hypothesis testing and interval estimation, likelihood and Bayesian methods, and large-sample asymptotics. Prerequisite: STAT 410." ;
    uca:courseNumber 510 ;
    uca:courseTitle "Mathematical Statistics" ;
    uca:hasOffering <https://example.org/uiuc-course-advisor/resource/offering/STAT510/2026-fa> ;
    uca:hasPrerequisiteExpression <https://example.org/uiuc-course-advisor/resource/prereq/STAT510> ;
    uca:inDepartment <https://example.org/uiuc-course-advisor/resource/department/STAT> ;
    uca:sourceURL "https://discovery.cs.illinois.edu/dataset/course-catalog/"^^xsd:anyURI .

<https://example.org/uiuc-course-advisor/resource/course/STAT511> a uca:Course ;
    rdfs:label "STAT 511 Advanced Mathematical Statistics" ;
    uca:courseCode "STAT 511" ;
    uca:courseCreditsMax 4.0 ;
    uca:courseCreditsMin 4.0 ;
    uca:courseDescription "Provides an advanced introduction to rigorous mathematical foundations of statistical inference, covering topics such as distribution theory, point estimation theory, interval estimation, theory of hypothesis testing, and decision theory. Prerequisite: Familiarity with probability theory and statistics at the level of STAT 410. For Graduate Students Only." ;
    uca:courseNumber 511 ;
    uca:courseTitle "Advanced Mathematical Statistics" ;
    uca:hasOffering <https://example.org/uiuc-course-advisor/resource/offering/STAT511/2026-fa> ;
    uca:hasPrerequisiteExpression <https://example.org/uiuc-course-advisor/resource/prereq/STAT511> ;
    uca:inDepartment <https://example.org/uiuc-course-advisor/resource/department/STAT> ;
    uca:sourceURL "https://discovery.cs.illinois.edu/dataset/course-catalog/"^^xsd:anyURI .

