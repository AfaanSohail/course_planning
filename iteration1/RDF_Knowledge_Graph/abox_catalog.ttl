<https://example.org/uiuc-course-advisor/resource/course/MATH413> a uca:Course ;
    rdfs:label "MATH 413 Intro to Combinatorics" ;
    uca:courseCode "MATH 413" ;
    uca:courseCreditsMax 4.0 ;
    uca:courseCreditsMin 3.0 ;
    uca:courseDescription "Permutations and combinations, generating functions, recurrence relations, inclusion and exclusion, Polya's theory of counting, and block designs. Same as CS 413. 3 undergraduate hours. 3 or 4 graduate hours. 4 hours of credit requires approval of the instructor and completion of additional work of substance. Prerequisite: MATH 314 or MATH 347 or equivalent experience." ;
    uca:courseNumber 413 ;
    uca:courseTitle "Intro to Combinatorics" ;
    uca:crossListedWith <https://example.org/uiuc-course-advisor/resource/course/CS413> ;
