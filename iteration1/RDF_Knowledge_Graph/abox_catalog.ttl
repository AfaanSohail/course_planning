<https://example.org/uiuc-course-advisor/resource/course/PHYS325> a uca:Course ;
    rdfs:label "PHYS 325 Classical Mechanics I" ;
    uca:courseCode "PHYS 325" ;
    uca:courseCreditsMax 3.0 ;
    uca:courseCreditsMin 3.0 ;
    uca:courseDescription "Kinematics and dynamics of classical systems, including a review of Newtonian kinematics and dynamics. Three dimensional motion, variable mass, and conservation laws; damped and periodically driven oscillations; gravitational potential of extended objects and motion in rotating frames of reference; Lagrangian and Hamiltonian mechanics. Prerequisite: PHYS 225; credit or concurrent registration in MATH 285 or MATH 286." ;
    uca:courseNumber 325 ;
    uca:courseTitle "Classical Mechanics I" ;
    uca:hasOffering <https://example.org/uiuc-course-advisor/resource/offering/PHYS325/2026-fa> ;
    uca:hasPrerequisiteExpression <https://example.org/uiuc-course-advisor/resource/prereq/PHYS325> ;
    uca:inDepartment <https://example.org/uiuc-course-advisor/resource/department/PHYS> ;
    uca:sourceURL "https://discovery.cs.illinois.edu/dataset/course-catalog/"^^xsd:anyURI .

<https://example.org/uiuc-course-advisor/resource/course/PHYS435> a uca:Course ;
    rdfs:label "PHYS 435 Electromagnetic Fields I" ;
    uca:courseCode "PHYS 435" ;
    uca:courseCreditsMax 3.0 ;
    uca:courseCreditsMin 3.0 ;
    uca:courseDescription "Static electric and magnetic fields, their interactions with electric charge and current, and their transformation properties; the effect of special relativity is incorporated. Macroscopic fields in material media are described. Register for the lecture and one of the discussion sections. 3 undergraduate hours. 3 graduate hours. Prerequisite: MATH 285 and PHYS 325. Credit or concurrent enrollment in MATH 257 or MATH 416." ;
    uca:courseNumber 435 ;
    uca:courseTitle "Electromagnetic Fields I" ;
    uca:hasOffering <https://example.org/uiuc-course-advisor/resource/offering/PHYS435/2026-fa> ;
    uca:hasPrerequisiteExpression <https://example.org/uiuc-course-advisor/resource/prereq/PHYS435> ;
    uca:inDepartment <https://example.org/uiuc-course-advisor/resource/department/PHYS> ;
    uca:sourceURL "https://discovery.cs.illinois.edu/dataset/course-catalog/"^^xsd:anyURI .

