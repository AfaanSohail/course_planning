<https://example.org/uiuc-course-advisor/resource/course/CS101> a uca:Course ;
    rdfs:label "CS 101 Intro Computing: Engrg & Sci" ;
    uca:courseCode "CS 101" ;
    uca:courseCreditsMax 3.0 ;
    uca:courseCreditsMin 3.0 ;
    uca:courseDescription "Fundamental principles, concepts, and methods of computing, with emphasis on applications in the physical sciences and engineering. Basic problem solving and programming techniques; fundamental algorithms and data structures; use of computers in solving engineering and scientific problems. Intended for engineering and science majors. Prerequisite: One of MATH 220 or MATH 221 or MATH 231 or MATH 241." ;
    uca:courseNumber 101 ;
    uca:courseTitle "Intro Computing: Engrg & Sci" ;
    uca:hasDegreeAttribute "Quantitative Reasoning II course." ;
    uca:hasOffering <https://example.org/uiuc-course-advisor/resource/offering/CS101/2026-fa> ;
    uca:hasPrerequisiteExpression <https://example.org/uiuc-course-advisor/resource/prereq/CS101> ;
    uca:inDepartment <https://example.org/uiuc-course-advisor/resource/department/CS> ;
    uca:sourceURL "https://discovery.cs.illinois.edu/dataset/course-catalog/"^^xsd:anyURI .

