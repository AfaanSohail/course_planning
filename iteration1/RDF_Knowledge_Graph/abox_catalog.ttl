<https://example.org/uiuc-course-advisor/resource/course/STAT429> a uca:Course ;
    rdfs:label "STAT 429 Time Series Analysis" ;
    uca:courseCode "STAT 429" ;
    uca:courseCreditsMax 4.0 ;
    uca:courseCreditsMin 3.0 ;
    uca:courseDescription "Studies theory and data analysis for time series; examines auto-regressive moving average model building and statistical techniques; and discusses spectral model building and statistical analysis using windowed periodograms and Fast Fourier Transformations. 3 undergraduate hours. 4 graduate hours. Prerequisite: STAT 410." ;
    uca:courseNumber 429 ;
    uca:courseTitle "Time Series Analysis" ;
    uca:hasOffering <https://example.org/uiuc-course-advisor/resource/offering/STAT429/2026-fa> ;
