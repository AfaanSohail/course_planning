<https://example.org/uiuc-course-advisor/resource/course/FSHN120> a uca:Course ;
    rdfs:label "FSHN 120 Contemporary Nutrition" ;
    uca:courseCode "FSHN 120" ;
    uca:courseCreditsMax 3.0 ;
    uca:courseCreditsMin 3.0 ;
    uca:courseDescription "Fundamental principles of human nutrition and their application to the selection of an adequate diet for health and wellness; current nutrition topics of importance. Credit is not given for FSHN 120 if credit has been given for FSHN 220." ;
