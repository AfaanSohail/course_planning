<https://example.org/uiuc-course-advisor/resource/course/GEOL100> a uca:Course ;
    rdfs:label "GEOL 100 Planet Earth" ;
    uca:courseCode "GEOL 100" ;
    uca:courseCreditsMax 3.0 ;
    uca:courseCreditsMin 3.0 ;
    uca:courseDescription "[IAI Code: P1907] Introduces non-science majors to physical aspects (earthquakes, volcanoes, floods, tsunamis, mountains, plate tectonics) and historical aspects (formation of earth and life, dinosaurs, ice age, evolution of climate) in earth science. Presents information on earth resources, natural hazards, and development of natural landscapes. Focuses on humanistic issues; provides context for understanding environmental change. Optional lab demonstrations and field trips with co-registration in GEOL 110. Credit is not given toward graduation for: Credit is not given for both GEOL 100 and GEOL 101, GEOL 103 or GEOL 107." ;
    uca:courseNumber 100 ;
    uca:courseTitle "Planet Earth" ;
    uca:hasDegreeAttribute "Nat Sci & Tech - Phys Sciences course." ;
    uca:hasOffering <https://example.org/uiuc-course-advisor/resource/offering/GEOL100/2026-fa> ;
    uca:inDepartment <https://example.org/uiuc-course-advisor/resource/department/GEOL> ;
    uca:sourceURL "https://discovery.cs.illinois.edu/dataset/course-catalog/"^^xsd:anyURI .

