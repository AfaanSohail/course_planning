<https://example.org/uiuc-course-advisor/resource/course/MSE182> a uca:Course ;
    rdfs:label "MSE 182 Introduction to MatSE" ;
    uca:courseCode "MSE 182" ;
    uca:courseCreditsMax 2.0 ;
    uca:courseCreditsMin 2.0 ;
    uca:courseDescription "Overview of MatSE as a basis for understanding how structure, property, and processing relationships are developed and used for different types of materials. Case studies of advances in new materials and processes illustrating the role of materials in modern society. Laboratory-discussion demonstrations and experiments. Design-team analysis or synthesis of objects that use materials creatively." ;
    uca:courseNumber 182 ;
    uca:courseTitle "Introduction to MatSE" ;
    uca:hasOffering <https://example.org/uiuc-course-advisor/resource/offering/MSE182/2026-fa> ;
    uca:inDepartment <https://example.org/uiuc-course-advisor/resource/department/MSE> ;
    uca:sourceURL "https://discovery.cs.illinois.edu/dataset/course-catalog/"^^xsd:anyURI .

<https://example.org/uiuc-course-advisor/resource/course/MSE201> a uca:Course ;
    rdfs:label "MSE 201 Phases and Phase Relations" ;
    uca:courseCode "MSE 201" ;
    uca:courseCreditsMax 3.0 ;
    uca:courseCreditsMin 3.0 ;
    uca:courseDescription "Understanding microstructure. Quantitative examination of phases (crystalline and non-crystalline structures) and the relationships between phases (phase diagrams). Commercial practices for producing desired microscopic phase configurations and macroscopic shapes (processing). Credit is not given for both MSE 201 and MSE 280. Prerequisite: MSE 182; credit or concurrent enrollment in CHEM 104, MATH 231 and PHYS 211." ;
    uca:courseNumber 201 ;
    uca:courseTitle "Phases and Phase Relations" ;
    uca:hasOffering <https://example.org/uiuc-course-advisor/resource/offering/MSE201/2026-fa> ;
    uca:hasPrerequisiteExpression <https://example.org/uiuc-course-advisor/resource/prereq/MSE201> ;
    uca:inDepartment <https://example.org/uiuc-course-advisor/resource/department/MSE> ;
    uca:sourceURL "https://discovery.cs.illinois.edu/dataset/course-catalog/"^^xsd:anyURI .

<https://example.org/uiuc-course-advisor/resource/course/MSE280> a uca:Course ;
    rdfs:label "MSE 280 Engineering Materials" ;
    uca:courseCode "MSE 280" ;
    uca:courseCreditsMax 3.0 ;
    uca:courseCreditsMin 3.0 ;
    uca:courseDescription "Materials science and engineering of ceramics, electronic materials, metals and polymers. Bonding; crystallography; imperfections; processing and properties of semiconductors, polymers, metals, ceramics and composites; phase diagrams. Case studies. Credit is not given for both MSE 280 and any of CEE 300, ME 330, MSE 201. Prerequisite: CHEM 102 and PHYS 211." ;
    uca:courseNumber 280 ;
    uca:courseTitle "Engineering Materials" ;
    uca:hasOffering <https://example.org/uiuc-course-advisor/resource/offering/MSE280/2026-fa> ;
    uca:hasPrerequisiteExpression <https://example.org/uiuc-course-advisor/resource/prereq/MSE280> ;
    uca:inDepartment <https://example.org/uiuc-course-advisor/resource/department/MSE> ;
    uca:sourceURL "https://discovery.cs.illinois.edu/dataset/course-catalog/"^^xsd:anyURI .

<https://example.org/uiuc-course-advisor/resource/course/MSE401> a uca:Course ;
    rdfs:label "MSE 401 Thermodynamics of Materials" ;
    uca:courseCode "MSE 401" ;
    uca:courseCreditsMax 3.0 ;
    uca:courseCreditsMin 3.0 ;
    uca:courseDescription "Basic thermodynamic principles including energy, entropy, and free energy; macroscopic properties of hard and soft materials systems, such as equilibrium states, phases, and phase transitions. Application of phase diagrams. Statistical interpretation of thermodynamics on the atomistic level. 3 undergraduate hours. 3 graduate hours. Credit is not given for both MSE 401 and CHEM 444 or PHYS 427. Prerequisite: MSE 201 or MSE 280; credit or concurrent registration in MATH 285." ;
    uca:courseNumber 401 ;
    uca:courseTitle "Thermodynamics of Materials" ;
    uca:hasOffering <https://example.org/uiuc-course-advisor/resource/offering/MSE401/2026-fa> ;
    uca:hasPrerequisiteExpression <https://example.org/uiuc-course-advisor/resource/prereq/MSE401> ;
    uca:inDepartment <https://example.org/uiuc-course-advisor/resource/department/MSE> ;
    uca:sourceURL "https://discovery.cs.illinois.edu/dataset/course-catalog/"^^xsd:anyURI .

