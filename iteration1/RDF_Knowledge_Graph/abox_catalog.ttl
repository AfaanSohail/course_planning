<https://example.org/uiuc-course-advisor/resource/course/MSE101> a uca:Course ;
    rdfs:label "MSE 101 Materials in Today's World" ;
    uca:courseCode "MSE 101" ;
    uca:courseCreditsMax 3.0 ;
    uca:courseCreditsMin 3.0 ;
