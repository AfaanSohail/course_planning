<https://example.org/uiuc-course-advisor/resource/course/CS440> a uca:Course ;
    rdfs:label "CS 440 Artificial Intelligence" ;
    uca:courseCode "CS 440" ;
    uca:courseCreditsMax 4.0 ;
    uca:courseCreditsMin 3.0 ;
    uca:courseDescription "Major topics in and directions of research in artificial intelligence: basic problem solving techniques, knowledge representation and computer inference, machine learning, natural language understanding, computer vision, robotics, and societal impacts. Same as ECE 448. 3 undergraduate hours. 3 or 4 graduate hours. Prerequisite: CS 225; one of CS 361, STAT 361, ECE 313, MATH 362, MATH 461, MATH 463, STAT 400 or BIOE 310." ;
    uca:courseNumber 440 ;
    uca:courseTitle "Artificial Intelligence" ;
    uca:crossListedWith <https://example.org/uiuc-course-advisor/resource/course/ECE448> ;
