<https://example.org/uiuc-course-advisor/resource/course/MATH412> a uca:Course ;
    rdfs:label "MATH 412 Graph Theory" ;
    uca:courseCode "MATH 412" ;
    uca:courseCreditsMax 4.0 ;
    uca:courseCreditsMin 3.0 ;
    uca:courseDescription "Examines basic concepts and applications of graph theory, where graph refers to a set of vertices and edges that join some pairs of vertices; topics include subgraphs, connectivity, trees, cycles, vertex and edge coloring, planar graphs and their colorings. Draws applications from computer science, operations research, chemistry, the social sciences, and other branches of mathematics, but emphasis is placed on theoretical aspects of graphs. 3 or 4 undergraduate hours. 3 or 4 graduate hours. 4 hours of credit requires approval of the instructor and department with completion of additional work of substance. Prerequisite: MATH 314 or MATH 347 or equivalent experience or CS 374." ;
    uca:courseNumber 412 ;
    uca:courseTitle "Graph Theory" ;
    uca:hasOffering <https://example.org/uiuc-course-advisor/resource/offering/MATH412/2026-fa> ;
    uca:hasPrerequisiteExpression <https://example.org/uiuc-course-advisor/resource/prereq/MATH412> ;
    uca:inDepartment <https://example.org/uiuc-course-advisor/resource/department/MATH> ;
    uca:sourceURL "https://discovery.cs.illinois.edu/dataset/course-catalog/"^^xsd:anyURI .

