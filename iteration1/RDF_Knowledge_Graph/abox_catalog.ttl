<https://example.org/uiuc-course-advisor/resource/course/MATH510> a uca:Course ;
    rdfs:label "MATH 510 Riemann Surf & Algebraic Curv" ;
    uca:courseCode "MATH 510" ;
    uca:courseCreditsMax 4.0 ;
    uca:courseCreditsMin 4.0 ;
    uca:courseDescription "An introduction to Riemann Surfaces from both the algebraic and function-theoretic points of view. Topics include holomorphic and meromorphic differential forms, integration of differential forms, divisors and linear equivalence, the genus of a compact Riemann surface, projective algebraic curves, the Riemann-Roch theorem, and applications. Prerequisite: MATH 542." ;
