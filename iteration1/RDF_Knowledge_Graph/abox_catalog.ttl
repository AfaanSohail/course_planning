    uca:inDepartment <https://example.org/uiuc-course-advisor/resource/department/ECE> ;
    uca:sourceURL "https://discovery.cs.illinois.edu/dataset/course-catalog/"^^xsd:anyURI .

<https://example.org/uiuc-course-advisor/resource/course/PHYS212> a uca:Course ;
    rdfs:label "PHYS 212 University Physics: Elec & Mag" ;
    uca:courseCode "PHYS 212" ;
    uca:courseCreditsMax 4.0 ;
    uca:courseCreditsMin 4.0 ;
    uca:courseDescription "[IAI Code: PHY912] Coulomb's Law, electric fields, Gauss' Law, electric potential, capacitance, circuits, magnetic forces and fields, Ampere's law, induction, electromagnetic waves, polarization, and geometrical optics. A calculus-based approach for majors in engineering, mathematics, physics, and chemistry. Credit is not given toward graduation for: Credit is not given for both PHYS 212 and PHYS 102. Prerequisite: PHYS 211; credit or concurrent registration in MATH 241." ;
    uca:courseNumber 212 ;
