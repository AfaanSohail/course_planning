<https://example.org/uiuc-course-advisor/resource/course/CS511> a uca:Course ;
    rdfs:label "CS 511 Advanced Data Management" ;
    uca:courseCode "CS 511" ;
    uca:courseCreditsMax 4.0 ;
    uca:courseCreditsMin 4.0 ;
    uca:courseDescription "Advanced concepts in data management and information system design and implementation, and recent developments in the field. 1) Relational roots, objects and extensibility, query languages, data indexing, query processing, transaction processing, benchmarks, and 2) semi-structured data and unstructured data, information extraction, information integration, web search and mining, and other emerging directions in the field. Prerequisite: CS 411." ;
    uca:courseNumber 511 ;
    uca:courseTitle "Advanced Data Management" ;
    uca:hasOffering <https://example.org/uiuc-course-advisor/resource/offering/CS511/2026-fa> ;
