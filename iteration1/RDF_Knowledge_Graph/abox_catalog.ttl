<https://example.org/uiuc-course-advisor/resource/course/STAT428> a uca:Course ;
    rdfs:label "STAT 428 Statistical Computing" ;
    uca:courseCode "STAT 428" ;
    uca:courseCreditsMax 4.0 ;
    uca:courseCreditsMin 3.0 ;
    uca:courseDescription "Examines statistical packages, numerical analysis for linear and nonlinear models, graphics, and random number generation and Monte Carlo methods. Same as CSE 428. 3 undergraduate hours. 4 graduate hours. Prerequisite: STAT 410 or equivalent; knowledge of a programming language." ;
