<https://example.org/uiuc-course-advisor/resource/course/BIOE310> a uca:Course ;
    rdfs:label "BIOE 310 Computational Tools for Biological Data" ;
    uca:courseCode "BIOE 310" ;
    uca:courseCreditsMax 3.0 ;
    uca:courseCreditsMin 3.0 ;
    uca:courseDescription "Fundamental and applied statistics, including probability distributions, parameter estimation, descriptive statistics, hypothesis testing, and linear regression. Statistical methods in genomics including sequence analysis, gene expression data analysis, human genomic variation, regulatory genomics, and cancer genomics. Credit is not given towards graduation for both BIOE 310 and IE 300. Prerequisite: BIOE 210 or MATH 257. Students in the BS-BIOE must take BIOE 210 as the prerequisite." ;
    uca:courseNumber 310 ;
    uca:courseTitle "Computational Tools for Biological Data" ;
    uca:hasOffering <https://example.org/uiuc-course-advisor/resource/offering/BIOE310/2026-fa> ;
    uca:hasPrerequisiteExpression <https://example.org/uiuc-course-advisor/resource/prereq/BIOE310> ;
    uca:inDepartment <https://example.org/uiuc-course-advisor/resource/department/BIOE> ;
    uca:sourceURL "https://discovery.cs.illinois.edu/dataset/course-catalog/"^^xsd:anyURI .

<https://example.org/uiuc-course-advisor/resource/course/CS438> a uca:Course ;
    rdfs:label "CS 438 Communication Networks" ;
    uca:courseCode "CS 438" ;
    uca:courseCreditsMax 4.0 ;
    uca:courseCreditsMin 3.0 ;
    uca:courseDescription "Layered architectures and the OSI Reference Model; design issues and protocols in the transport, network, and data link layers; architectures and control algorithms of local-area, point-to-point, and satellite networks; standards in networks access protocols; models of network interconnection; overview of networking and communication software. Same as ECE 438. 3 undergraduate hours. 3 or 4 graduate hours. Prerequisite: One of CS 241, CS 341 or ECE 391; strongly recommend one of CS 361, STAT 361, ECE 313, MATH 362, MATH 461, MATH 463 or STAT 400." ;
    uca:courseNumber 438 ;
    uca:courseTitle "Communication Networks" ;
    uca:crossListedWith <https://example.org/uiuc-course-advisor/resource/course/ECE438> ;
    uca:hasOffering <https://example.org/uiuc-course-advisor/resource/offering/CS438/2026-fa> ;
    uca:hasPrerequisiteExpression <https://example.org/uiuc-course-advisor/resource/prereq/CS438> ;
    uca:inDepartment <https://example.org/uiuc-course-advisor/resource/department/CS> ;
    uca:sourceURL "https://discovery.cs.illinois.edu/dataset/course-catalog/"^^xsd:anyURI .

<https://example.org/uiuc-course-advisor/resource/course/CS463> a uca:Course ;
    rdfs:label "CS 463 Computer Security II" ;
    uca:courseCode "CS 463" ;
    uca:courseCreditsMax 4.0 ;
    uca:courseCreditsMin 3.0 ;
    uca:courseDescription "Program security, trusted base, privacy, anonymity, non-interference, information flow, confinement, advanced auditing, forensics, intrusion detection, key management and distribution, policy composition and analysis, formal approaches to specification and verification of secure systems and protocols, and topics in applied cryptography. Same as ECE 424. 3 undergraduate hours. 3 or 4 graduate hours. Prerequisite: CS 225 and one of CS 361, STAT 361, ECE 313, MATH 362, MATH 461, MATH 463 or STAT 400. CS 441 completion is recommended." ;
    uca:courseNumber 463 ;
    uca:courseTitle "Computer Security II" ;
    uca:crossListedWith <https://example.org/uiuc-course-advisor/resource/course/ECE424> ;
    uca:hasOffering <https://example.org/uiuc-course-advisor/resource/offering/CS463/2026-fa> ;
    uca:hasPrerequisiteExpression <https://example.org/uiuc-course-advisor/resource/prereq/CS463> ;
    uca:inDepartment <https://example.org/uiuc-course-advisor/resource/department/CS> ;
    uca:sourceURL "https://discovery.cs.illinois.edu/dataset/course-catalog/"^^xsd:anyURI .

<https://example.org/uiuc-course-advisor/resource/course/CS473> a uca:Course ;
    rdfs:label "CS 473 Algorithms" ;
    uca:courseCode "CS 473" ;
    uca:courseCreditsMax 4.0 ;
    uca:courseCreditsMin 4.0 ;
    uca:courseDescription "Design and analysis techniques, approximation algorithms, randomized algorithms and amortized analysis, and advanced topics such as network flow, linear programming, and dynamic data structures, among others. Same as CSE 414 and MATH 473. 4 undergraduate hours. 4 graduate hours. Prerequisite: CS 374 or ECE 374, and one of CS 361, STAT 361, ECE 313, MATH 362, MATH 461, MATH 463 or STAT 400." ;
    uca:courseNumber 473 ;
    uca:courseTitle "Algorithms" ;
    uca:crossListedWith <https://example.org/uiuc-course-advisor/resource/course/CSE414>,
        <https://example.org/uiuc-course-advisor/resource/course/MATH473> ;
    uca:hasOffering <https://example.org/uiuc-course-advisor/resource/offering/CS473/2026-fa> ;
    uca:hasPrerequisiteExpression <https://example.org/uiuc-course-advisor/resource/prereq/CS473> ;
    uca:inDepartment <https://example.org/uiuc-course-advisor/resource/department/CS> ;
    uca:sourceURL "https://discovery.cs.illinois.edu/dataset/course-catalog/"^^xsd:anyURI .

