<https://example.org/uiuc-course-advisor/resource/course/CS210> a uca:Course ;
    rdfs:label "CS 210 Ethical & Professional Issues" ;
    uca:courseCode "CS 210" ;
    uca:courseCreditsMax 2.0 ;
    uca:courseCreditsMin 2.0 ;
    uca:courseDescription "Ethics for the computing profession. Ethical decision-making; licensing; intellectual property, freedom of information, and privacy. Credit is not given for both CS 210 and either CS 211 or ECE 316. Prerequisite: CS 225. Junior standing required." ;
    uca:courseNumber 210 ;
    uca:courseTitle "Ethical & Professional Issues" ;
    uca:hasOffering <https://example.org/uiuc-course-advisor/resource/offering/CS210/2026-fa> ;
