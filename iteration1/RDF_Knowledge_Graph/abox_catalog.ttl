<https://example.org/uiuc-course-advisor/resource/course/CS225> a uca:Course ;
    rdfs:label "CS 225 Data Structures" ;
    uca:courseCode "CS 225" ;
    uca:courseCreditsMax 4.0 ;
    uca:courseCreditsMin 4.0 ;
    uca:courseDescription "Data abstractions: elementary data structures (lists, stacks, queues, and trees) and their implementation using an object-oriented programming language. Solutions to a variety of computational problems such as search on graphs and trees. Elementary analysis of algorithms. Credit is not given toward graduation for: CS 277 if credit for CS 225 has been earned. Prerequisite: CS 126 or CS 128 or ECE 220; One of CS 173, CS 413, MATH 213, MATH 314, MATH 347, MATH 412, or MATH 413." ;
    uca:courseNumber 225 ;
    uca:courseTitle "Data Structures" ;
    uca:hasDegreeAttribute "Quantitative Reasoning II course." ;
    uca:hasOffering <https://example.org/uiuc-course-advisor/resource/offering/CS225/2026-fa> ;
