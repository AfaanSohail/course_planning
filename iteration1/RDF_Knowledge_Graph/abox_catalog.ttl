<https://example.org/uiuc-course-advisor/resource/course/CS425> a uca:Course ;
    rdfs:label "CS 425 Distributed Systems" ;
    uca:courseCode "CS 425" ;
    uca:courseCreditsMax 4.0 ;
    uca:courseCreditsMin 3.0 ;
    uca:courseDescription "Protocols, specification techniques, global states and their determination, reliable broadcast, transactions and commitment, security, and real-time systems. Same as ECE 428. 3 or 4 undergraduate hours. 3 or 4 graduate hours. Prerequisite: Credit or concurrent enrollment in one of CS 240, CS 241, CS 340, CS 341 or ECE 391." ;
    uca:courseNumber 425 ;
    uca:courseTitle "Distributed Systems" ;
    uca:crossListedWith <https://example.org/uiuc-course-advisor/resource/course/ECE428> ;
