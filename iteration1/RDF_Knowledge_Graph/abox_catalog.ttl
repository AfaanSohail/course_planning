    uca:sourceURL "https://discovery.cs.illinois.edu/dataset/course-catalog/"^^xsd:anyURI .

<https://example.org/uiuc-course-advisor/resource/course/STAT426> a uca:Course ;
    rdfs:label "STAT 426 Statistical Modeling II" ;
    uca:courseCode "STAT 426" ;
    uca:courseCreditsMax 4.0 ;
    uca:courseCreditsMin 3.0 ;
    uca:courseDescription "This is a continuation in the study of advanced statistical modeling techniques with a focus on categorical data. The course explores logistic regression, generalized linear models, goodness-of-fit, link functions, count regression, log-linear models, probability models for contingency tables, and ordinal response models. Statistical computing is an integral part of the course. 3 undergraduate hours. 4 graduate hours. Prerequisite: STAT 410; STAT 425." ;
    uca:courseNumber 426 ;
    uca:courseTitle "Statistical Modeling II" ;
    uca:hasOffering <https://example.org/uiuc-course-advisor/resource/offering/STAT426/2026-fa> ;
    uca:hasPrerequisiteExpression <https://example.org/uiuc-course-advisor/resource/prereq/STAT426> ;
    uca:inDepartment <https://example.org/uiuc-course-advisor/resource/department/STAT> ;
    uca:sourceURL "https://discovery.cs.illinois.edu/dataset/course-catalog/"^^xsd:anyURI .

<https://example.org/uiuc-course-advisor/resource/course/STAT440> a uca:Course ;
    rdfs:label "STAT 440 Statistical Data Management" ;
    uca:courseCode "STAT 440" ;
    uca:courseCreditsMax 4.0 ;
    uca:courseCreditsMin 3.0 ;
    uca:courseDescription "The critical elements of data storage, data cleaning, and data extractions that ultimately lead to data analysis are presented. Includes basic theory and methods of databases, auditing and querying databases, as well as data management and data preparation using standard large-scale statistical software. Students will gain competency in the skills required in storing, cleaning, and managing data, all of which are required prior to data analysis. Same as CSE 440. 3 undergraduate hours. 4 graduate hours. Prerequisite: STAT 400 or STAT 409." ;
    uca:courseNumber 440 ;
    uca:courseTitle "Statistical Data Management" ;
    uca:crossListedWith <https://example.org/uiuc-course-advisor/resource/course/CSE440> ;
    uca:hasOffering <https://example.org/uiuc-course-advisor/resource/offering/STAT440/2026-fa> ;
    uca:hasPrerequisiteExpression <https://example.org/uiuc-course-advisor/resource/prereq/STAT440> ;
    uca:inDepartment <https://example.org/uiuc-course-advisor/resource/department/STAT> ;
    uca:sourceURL "https://discovery.cs.illinois.edu/dataset/course-catalog/"^^xsd:anyURI .

