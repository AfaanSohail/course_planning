<https://example.org/uiuc-course-advisor/resource/course/ECE330> a uca:Course ;
    rdfs:label "ECE 330 Power Ckts & Electromechanics" ;
    uca:courseCode "ECE 330" ;
    uca:courseCreditsMax 3.0 ;
    uca:courseCreditsMin 3.0 ;
