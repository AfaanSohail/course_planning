<https://example.org/uiuc-course-advisor/resource/course/MATH423> a uca:Course ;
    rdfs:label "MATH 423 Differential Geometry" ;
    uca:courseCode "MATH 423" ;
    uca:courseCreditsMax 4.0 ;
    uca:courseCreditsMin 3.0 ;
    uca:courseDescription "Applications of the calculus to the study of the shape and curvature of curves and surfaces; introduction to vector fields, differential forms on Euclidean spaces, and the method of moving frames for low- dimensional differential geometry. 3 or 4 undergraduate hours. 3 or 4 graduate hours. 4 hours of credit requires approval of the instructor and department with completion of additional work of substance. Prerequisite: MATH 241 or equivalent." ;
    uca:courseNumber 423 ;
    uca:courseTitle "Differential Geometry" ;
    uca:hasOffering <https://example.org/uiuc-course-advisor/resource/offering/MATH423/2026-fa> ;
