<https://example.org/uiuc-course-advisor/resource/course/PHYS420> a uca:Course ;
    rdfs:label "PHYS 420 Space, Time, and Matter" ;
    uca:courseCode "PHYS 420" ;
    uca:courseCreditsMax 2.0 ;
    uca:courseCreditsMin 2.0 ;
    uca:courseDescription "Philosophical examination of some fundamental concepts and theories of the physical world, such as time, matter, space, and geometry; interpretation of quantum theory. Same as PHIL 420. 2 undergraduate hours. 2 graduate hours. Credit is not given for both PHYS 420 and PHYS 419. Prerequisite: PHIL 101; PHYS 101 or PHYS 211." ;
