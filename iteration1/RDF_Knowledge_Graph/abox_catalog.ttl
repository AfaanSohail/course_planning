<https://example.org/uiuc-course-advisor/resource/course/STAT410> a uca:Course ;
    rdfs:label "STAT 410 Statistics and Probability II" ;
    uca:courseCode "STAT 410" ;
    uca:courseCreditsMax 4.0 ;
    uca:courseCreditsMin 3.0 ;
    uca:courseDescription "Continuation of STAT 400. Includes moment-generating functions, transformations of random variables, normal sampling theory, sufficiency, best estimators, maximum likelihood estimators, confidence intervals, most powerful tests, unbiased tests, and chi-square tests. Same as MATH 464. 3 undergraduate hours. 4 graduate hours. Credit is not given for both STAT 410 and STAT 409. Prerequisite: MATH 241 and STAT 400." ;
