    uca:inDepartment <https://example.org/uiuc-course-advisor/resource/department/MATH> ;
    uca:sourceURL "https://discovery.cs.illinois.edu/dataset/course-catalog/"^^xsd:anyURI .

<https://example.org/uiuc-course-advisor/resource/course/MATH405> a uca:Course ;
    rdfs:label "MATH 405 Teacher's Course" ;
    uca:courseCode "MATH 405" ;
    uca:courseCreditsMax 4.0 ;
    uca:courseCreditsMin 3.0 ;
    uca:courseDescription "In-depth, advanced perspective look at selected topics covered in the secondary curriculum. Connects mathematics learned at the university level to content introduced at the secondary level. Intended for students who plan to seek a secondary certificate in mathematics teaching. 3 or 4 undergraduate hours. 3 or 4 graduate hours. 4 hours of credit requires approval of the instructor and department with completion of additional work of substance. Prerequisite: MATH 241; MATH 314 or MATH 347, or equivalent; or consent of instructor." ;
    uca:courseNumber 405 ;
    uca:courseTitle "Teacher's Course" ;
    uca:hasOffering <https://example.org/uiuc-course-advisor/resource/offering/MATH405/2026-fa> ;
