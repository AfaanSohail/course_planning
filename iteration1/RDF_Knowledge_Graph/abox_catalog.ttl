<https://example.org/uiuc-course-advisor/resource/course/CS424> a uca:Course ;
    rdfs:label "CS 424 Real-Time Systems" ;
    uca:courseCode "CS 424" ;
    uca:courseCreditsMax 4.0 ;
    uca:courseCreditsMin 3.0 ;
    uca:courseDescription "Supervisory control aspects of Cyber Physical Systems (CPS): fundamentals of reliability analysis, real-time scheduling, simple feedback control, software fault tolerance architecture, wireless networking and energy saving, principles of safety critical system engineering. Student groups design and demonstrate supervisory control architecture for a robot. 3 undergraduate hours. 3 or 4 graduate hours. Prerequisite: One of CS 241, CS 341 or ECE 391." ;
    uca:courseNumber 424 ;
    uca:courseTitle "Real-Time Systems" ;
    uca:hasOffering <https://example.org/uiuc-course-advisor/resource/offering/CS424/2026-fa> ;
