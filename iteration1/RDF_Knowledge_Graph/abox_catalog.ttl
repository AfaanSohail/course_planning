<https://example.org/uiuc-course-advisor/resource/course/CS563> a uca:Course ;
    rdfs:label "CS 563 Advanced Computer Security" ;
    uca:courseCode "CS 563" ;
    uca:courseCreditsMax 4.0 ;
    uca:courseCreditsMin 4.0 ;
    uca:courseDescription "Current research trends in computer and network security. Privacy, tamper-resistance, unwanted traffic, monitoring and surveillance, and critical infrastructure protection. Subtopics will vary depending upon current research trends. Students work in teams in close coordination with the course instructor to develop one of the topics in depth by carrying out background research and an exploratory project. Same as ECE 524. Prerequisite: One of CS 461, CS 463, ECE 422 or ECE 424." ;
    uca:courseNumber 563 ;
    uca:courseTitle "Advanced Computer Security" ;
    uca:crossListedWith <https://example.org/uiuc-course-advisor/resource/course/ECE524> ;
