<https://example.org/uiuc-course-advisor/resource/course/ECE411> a uca:Course ;
    rdfs:label "ECE 411 Computer Organization & Design" ;
    uca:courseCode "ECE 411" ;
    uca:courseCreditsMax 4.0 ;
