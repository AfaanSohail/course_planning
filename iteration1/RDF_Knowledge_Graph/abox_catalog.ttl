<https://example.org/uiuc-course-advisor/resource/course/ECE457> a uca:Course ;
    rdfs:label "ECE 457 Microwave Devices & Circuits" ;
    uca:courseCode "ECE 457" ;
    uca:courseCreditsMax 3.0 ;
    uca:courseCreditsMin 3.0 ;
    uca:courseDescription "Electromagnetic wave propagation, microwave transmission systems, passive components, microwave tubes, solid state microwave devices, microwave integrated circuits, S-parameter analysis, and microstrip transmission lines. 3 undergraduate hours. 3 graduate hours. Prerequisite: ECE 340 and ECE 350." ;
