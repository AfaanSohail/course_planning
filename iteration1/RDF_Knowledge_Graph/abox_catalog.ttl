<https://example.org/uiuc-course-advisor/resource/course/CS512> a uca:Course ;
    rdfs:label "CS 512 Data Mining Principles" ;
    uca:courseCode "CS 512" ;
    uca:courseCreditsMax 4.0 ;
    uca:courseCreditsMin 4.0 ;
    uca:courseDescription "An advanced course on principles and algorithms of data mining. Data cleaning and integration; descriptive and predictive mining; mining frequent, sequential, and structured patterns; clustering, outlier analysis and fraud detection; stream data, web, text, and biomedical data mining; security and privacy in data mining; research frontiers. Prerequisite: CS 412." ;
    uca:courseNumber 512 ;
