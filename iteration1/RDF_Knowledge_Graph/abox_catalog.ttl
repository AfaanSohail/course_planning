<https://example.org/uiuc-course-advisor/resource/course/CS545> a uca:Course ;
    rdfs:label "CS 545 Machine Learning for Signal Processing" ;
    uca:courseCode "CS 545" ;
    uca:courseCreditsMax 4.0 ;
    uca:courseCreditsMin 4.0 ;
    uca:courseDescription "Fundamentals of machine learning and signal processing as they pertain to the development of machines that can understand complex real-world signals, such as speech, images, movies, music, biological and mechanical readings, etc. Hands-on examples of how to decompose, analyze, classify, detect and consolidate signals, and examine various commonplace operations such as finding faces from camera feeds, organizing personal music collections, designing speech dialog systems and understanding movie content. Prerequisite: MATH 415; one of CS 361, STAT 361, MATH 461, MATH 463 or STAT 400." ;
    uca:courseNumber 545 ;
    uca:courseTitle "Machine Learning for Signal Processing" ;
