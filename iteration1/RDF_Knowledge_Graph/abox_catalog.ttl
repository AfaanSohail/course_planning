<https://example.org/uiuc-course-advisor/resource/course/MATH115> a uca:Course ;
    rdfs:label "MATH 115 Preparation for Calculus" ;
    uca:courseCode "MATH 115" ;
    uca:courseCreditsMax 3.0 ;
    uca:courseCreditsMin 3.0 ;
    uca:courseDescription "Reviews trigonometric, rational, exponential, and logarithmic functions; provides a full treatment of limits, definition of derivative, and an introduction to finding area under a curve. Intended for students who need preparation for MATH 220, either because they lack the content background or because they are not prepared for the rigor of a university calculus course. Credit is not given toward graduation for: Credit is not given for both MATH 115 and either MATH 014 or MATH 114. Credit is not given for MATH 115 if credit for either MATH 220 or MATH 221 has been earned. Prerequisite: MATH 112." ;
    uca:courseNumber 115 ;
    uca:courseTitle "Preparation for Calculus" ;
    uca:hasDegreeAttribute "Quantitative Reasoning I course." ;
    uca:hasOffering <https://example.org/uiuc-course-advisor/resource/offering/MATH115/2026-fa> ;
    uca:hasPrerequisiteExpression <https://example.org/uiuc-course-advisor/resource/prereq/MATH115> ;
    uca:inDepartment <https://example.org/uiuc-course-advisor/resource/department/MATH> ;
