<https://example.org/uiuc-course-advisor/resource/course/PHYS582> a uca:Course ;
    rdfs:label "PHYS 582 General Field Theory" ;
    uca:courseCode "PHYS 582" ;
    uca:courseCreditsMax 4.0 ;
    uca:courseCreditsMin 4.0 ;
    uca:courseDescription "Standard techniques of field theory as used by experimenters and theorists; relativistic quantum mechanics of a single particle; Lagrangian field theories, perturbation theory, and calculation of lowest-order processes; introduction to Feynman diagrams and higher order processes; examples taken from quantum electrodynamics, solid-state and elementary particle physics, and many-body theory. Prerequisite: PHYS 581." ;
    uca:courseNumber 582 ;
    uca:courseTitle "General Field Theory" ;
    uca:hasOffering <https://example.org/uiuc-course-advisor/resource/offering/PHYS582/2026-fa> ;
    uca:hasPrerequisiteExpression <https://example.org/uiuc-course-advisor/resource/prereq/PHYS582> ;
    uca:inDepartment <https://example.org/uiuc-course-advisor/resource/department/PHYS> ;
    uca:sourceURL "https://discovery.cs.illinois.edu/dataset/course-catalog/"^^xsd:anyURI .

<https://example.org/uiuc-course-advisor/resource/course/PSYC407> a uca:Course ;
    rdfs:label "PSYC 407" ;
    rdfs:comment "Referenced by a prerequisite, cross-listing or degree requirement but not present in the Fall 2026 catalog snapshot; only its code is known." ;
    uca:courseCode "PSYC 407" ;
