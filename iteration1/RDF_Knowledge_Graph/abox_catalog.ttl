<https://example.org/uiuc-course-advisor/resource/course/CS374> a uca:Course ;
    rdfs:label "CS 374 Introduction to Algorithms & Models of Computation" ;
    uca:courseCode "CS 374" ;
    uca:courseCreditsMax 4.0 ;
    uca:courseCreditsMin 4.0 ;
    uca:courseDescription "Analysis of algorithms, major paradigms of algorithm design including recursive algorithms, divide-and-conquer algorithms, dynamic programming, greedy algorithms, and graph algorithms. Formal models of computation including finite automata and Turing machines. Limitations of computation arising from fundamental notions of algorithm and from complexity-theoretic constraints. Reductions, undecidability and NP-completeness. Same as ECE 374. Prerequisite: One of CS 173, MATH 213; CS 225." ;
    uca:courseNumber 374 ;
    uca:courseTitle "Introduction to Algorithms & Models of Computation" ;
    uca:crossListedWith <https://example.org/uiuc-course-advisor/resource/course/ECE374> ;
    uca:hasOffering <https://example.org/uiuc-course-advisor/resource/offering/CS374/2026-fa> ;
    uca:hasPrerequisiteExpression <https://example.org/uiuc-course-advisor/resource/prereq/CS374> ;
    uca:inDepartment <https://example.org/uiuc-course-advisor/resource/department/CS> ;
    uca:sourceURL "https://discovery.cs.illinois.edu/dataset/course-catalog/"^^xsd:anyURI .

