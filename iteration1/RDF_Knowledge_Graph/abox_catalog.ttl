<https://example.org/uiuc-course-advisor/resource/course/PHYS225> a uca:Course ;
    rdfs:label "PHYS 225 Relativity & Math Applications" ;
    uca:courseCode "PHYS 225" ;
    uca:courseCreditsMax 2.0 ;
    uca:courseCreditsMin 2.0 ;
    uca:courseDescription "Theory of Special Relativity, with applications to kinematics and dynamics. Key mathematical methods as they apply to aspects of electromagnetic theory and classical mechanics, including vector analysis, series expansions, matrices, Fourier analysis, partial differentiation, three-dimensional calculus, and simple differential equations. Prerequisite: Credit or concurrent registration in PHYS 212." ;
    uca:courseNumber 225 ;
    uca:courseTitle "Relativity & Math Applications" ;
    uca:hasOffering <https://example.org/uiuc-course-advisor/resource/offering/PHYS225/2026-fa> ;
