<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
  xmlns:owl="http://www.w3.org/2002/07/owl#"
  xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
  xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
  xmlns:dcterms="http://purl.org/dc/terms/"
>
  <owl:ObjectProperty rdf:about="https://example.org/uiuc-course-advisor/ontology#hasPermissionFor">
    <rdfs:label xml:lang="en">hasPermissionFor</rdfs:label>
    <rdfs:comment>Documented approval/consent for a course.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/uiuc-course-advisor/ontology#Student"/>
    <rdfs:range rdf:resource="https://example.org/uiuc-course-advisor/ontology#Course"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://example.org/uiuc-course-advisor/ontology#CoreRequirement">
    <rdfs:label xml:lang="en">CoreRequirement</rdfs:label>
    <rdfs:comment>A degree requirement for compulsory/core courses.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://example.org/uiuc-course-advisor/ontology#DegreeRequirement"/>
    <owl:disjointWith rdf:resource="https://example.org/uiuc-course-advisor/ontology#ElectiveRequirement"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://example.org/uiuc-course-advisor/ontology#studentIdentifier">
    <rdfs:label xml:lang="en">studentIdentifier</rdfs:label>
    <rdfs:comment>Pseudonymous student reference; avoid real records in demos.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/uiuc-course-advisor/ontology#Student"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://example.org/uiuc-course-advisor/ontology#meetingDays">
    <rdfs:label xml:lang="en">meetingDays</rdfs:label>
    <rdfs:comment>Days-of-week string from the catalog (e.g. MWF, TR, ARRANGED).</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/uiuc-course-advisor/ontology#Section"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://example.org/uiuc-course-advisor/ontology#courseCreditsMin">
    <rdfs:label xml:lang="en">courseCreditsMin</rdfs:label>
    <rdfs:comment>Lower bound of credit hours (or fixed value).</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/uiuc-course-advisor/ontology#Course"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://example.org/uiuc-course-advisor/ontology#buildingName">
    <rdfs:label xml:lang="en">buildingName</rdfs:label>
    <rdfs:comment>Building name from the catalog; may be blank for online sections.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/uiuc-course-advisor/ontology#Section"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://example.org/uiuc-course-advisor/ontology#inDepartment">
    <rdfs:label xml:lang="en">inDepartment</rdfs:label>
    <rdfs:comment>Subject/department code identifies the course owner, not a meeting.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/uiuc-course-advisor/ontology#Course"/>
    <rdfs:range rdf:resource="https://example.org/uiuc-course-advisor/ontology#Department"/>
    <owl:inverseOf>
      <owl:ObjectProperty rdf:about="https://example.org/uiuc-course-advisor/ontology#hasCourse">
        <rdfs:label xml:lang="en">hasCourse</rdfs:label>
        <rdfs:comment>Inverse of inDepartment.</rdfs:comment>
        <rdfs:domain rdf:resource="https://example.org/uiuc-course-advisor/ontology#Department"/>
        <rdfs:range rdf:resource="https://example.org/uiuc-course-advisor/ontology#Course"/>
      </owl:ObjectProperty>
    </owl:inverseOf>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://example.org/uiuc-course-advisor/ontology#instructorName">
    <rdfs:label xml:lang="en">instructorName</rdfs:label>
    <rdfs:comment>Instructor name as printed in the catalog (e.g. "Kim, G").</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/uiuc-course-advisor/ontology#Instructor"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://example.org/uiuc-course-advisor/ontology#hasPrerequisiteCandidate">
    <rdfs:label xml:lang="en">hasPrerequisiteCandidate</rdfs:label>
    <rdfs:comment>Derived: a course mentioned anywhere in the prerequisite alternatives (chain hasPrerequisiteExpression o hasOption o hasCondition o mentionsCourse). NOT a universal mandatory prerequisite.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/uiuc-course-advisor/ontology#Course"/>
    <rdfs:range rdf:resource="https://example.org/uiuc-course-advisor/ontology#Course"/>
    <rdfs:subPropertyOf>
      <owl:ObjectProperty rdf:about="https://example.org/uiuc-course-advisor/ontology#hasPrerequisitePath">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:label xml:lang="en">hasPrerequisitePath</rdfs:label>
        <rdfs:comment>Transitive reachability across possible prerequisite-course mentions; NOT itself eligibility.</rdfs:comment>
        <rdfs:domain rdf:resource="https://example.org/uiuc-course-advisor/ontology#Course"/>
        <rdfs:range rdf:resource="https://example.org/uiuc-course-advisor/ontology#Course"/>
      </owl:ObjectProperty>
    </rdfs:subPropertyOf>
    <owl:propertyChainAxiom rdf:parseType="Collection">
      <rdf:Description rdf:about="https://example.org/uiuc-course-advisor/ontology#hasPrerequisiteExpression"/>
      <rdf:Description rdf:about="https://example.org/uiuc-course-advisor/ontology#hasOption"/>
      <rdf:Description rdf:about="https://example.org/uiuc-course-advisor/ontology#hasCondition"/>
      <rdf:Description rdf:about="https://example.org/uiuc-course-advisor/ontology#mentionsCourse"/>
    </owl:propertyChainAxiom>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://example.org/uiuc-course-advisor/ontology#minTechnicalGPA">
    <rdfs:label xml:lang="en">minTechnicalGPA</rdfs:label>
    <rdfs:comment>Minimum technical GPA (CS and Math courses for this program).</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/uiuc-course-advisor/ontology#DegreeProgram"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://example.org/uiuc-course-advisor/ontology#completionTerm">
    <rdfs:label xml:lang="en">completionTerm</rdfs:label>
    <rdfs:comment>Term in which a course was completed, if known.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/uiuc-course-advisor/ontology#CourseCompletion"/>
    <rdfs:range rdf:resource="https://example.org/uiuc-course-advisor/ontology#AcademicTerm"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://example.org/uiuc-course-advisor/ontology#CourseWithPrerequisites">
    <rdfs:label xml:lang="en">CourseWithPrerequisites</rdfs:label>
    <rdfs:comment>Defined class: a Course that has at least one PrerequisiteExpression. Membership is INFERRED by the reasoner (owl:equivalentClass), never asserted in the A-Box.</rdfs:comment>
    <owl:equivalentClass>
      <owl:Class rdf:nodeID="N3877cf818b9f488b993fa8c817e20bf2">
        <owl:intersectionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="https://example.org/uiuc-course-advisor/ontology#Course"/>
          <owl:Restriction rdf:nodeID="N0b247a50a09f4a0682309eff0f0132b2">
            <owl:onProperty>
              <owl:ObjectProperty rdf:about="https://example.org/uiuc-course-advisor/ontology#hasPrerequisiteExpression">
                <rdfs:label xml:lang="en">hasPrerequisiteExpression</rdfs:label>
                <rdfs:comment>Expression associated with the target course.</rdfs:comment>
                <rdfs:domain rdf:resource="https://example.org/uiuc-course-advisor/ontology#Course"/>
                <rdfs:range rdf:resource="https://example.org/uiuc-course-advisor/ontology#PrerequisiteExpression"/>
              </owl:ObjectProperty>
            </owl:onProperty>
            <owl:someValuesFrom rdf:resource="https://example.org/uiuc-course-advisor/ontology#PrerequisiteExpression"/>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://example.org/uiuc-course-advisor/ontology#minUpperDivisionCredits">
    <rdfs:label xml:lang="en">minUpperDivisionCredits</rdfs:label>
    <rdfs:comment>Minimum upper-division (300/400-level) credit hours.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/uiuc-course-advisor/ontology#DegreeProgram"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://example.org/uiuc-course-advisor/ontology#creditsEarned">
    <rdfs:label xml:lang="en">creditsEarned</rdfs:label>
    <rdfs:comment>Credits earned from this completion.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/uiuc-course-advisor/ontology#CourseCompletion"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://example.org/uiuc-course-advisor/ontology#endTime">
    <rdfs:label xml:lang="en">endTime</rdfs:label>
    <rdfs:comment>End time as printed (string, because ARRANGED/blank values occur).</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/uiuc-course-advisor/ontology#Section"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://example.org/uiuc-course-advisor/ontology#minimumStandingRank">
    <rdfs:label xml:lang="en">minimumStandingRank</rdfs:label>
    <rdfs:comment>Standing/year rank. Fixed encoding: 1=Freshman, 2=Sophomore, 3=Junior, 4=Senior, 5=Graduate. A requirement such as "Junior, Senior or Graduate" is stored as minimumStandingRank 3.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/uiuc-course-advisor/ontology#StandingCondition"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://example.org/uiuc-course-advisor/ontology#allocatedToRequirement">
    <rdfs:label xml:lang="en">allocatedToRequirement</rdfs:label>
    <rdfs:comment>Explicit degree-audit assignment; enforce no-double-count constraints in application logic.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/uiuc-course-advisor/ontology#CourseCompletion"/>
    <rdfs:range rdf:resource="https://example.org/uiuc-course-advisor/ontology#DegreeRequirement"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://example.org/uiuc-course-advisor/ontology#sectionCode">
    <rdfs:label xml:lang="en">sectionCode</rdfs:label>
    <rdfs:comment>Section label if section data exists.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/uiuc-course-advisor/ontology#Section"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://example.org/uiuc-course-advisor/ontology#year">
    <rdfs:label xml:lang="en">year</rdfs:label>
    <rdfs:comment>Calendar year of academic term.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/uiuc-course-advisor/ontology#AcademicTerm"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://example.org/uiuc-course-advisor/ontology#enrollmentStatus">
    <rdfs:label xml:lang="en">enrollmentStatus</rdfs:label>
    <rdfs:comment>Enrollment Status column (Open, Closed, CrossListOpen ...), observed snapshot only.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/uiuc-course-advisor/ontology#Section"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://example.org/uiuc-course-advisor/ontology#parseStatus">
    <rdfs:label xml:lang="en">parseStatus</rdfs:label>
    <rdfs:comment>parsed, needs_review, unknown; NOT OWL reasoning result.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/uiuc-course-advisor/ontology#PrerequisiteExpression"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://example.org/uiuc-course-advisor/ontology#sectionType">
    <rdfs:label xml:lang="en">sectionType</rdfs:label>
    <rdfs:comment>Meeting type from the catalog Type column (Lecture, Discussion/Recitation, Laboratory, Online ...).</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/uiuc-course-advisor/ontology#Section"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://example.org/uiuc-course-advisor/ontology#subjectCode">
    <rdfs:label xml:lang="en">subjectCode</rdfs:label>
    <rdfs:comment>Academic subject code, e.g. CS.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/uiuc-course-advisor/ontology#Department"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://example.org/uiuc-course-advisor/ontology#allowsConcurrent">
    <rdfs:label xml:lang="en">allowsConcurrent</rdfs:label>
    <rdfs:comment>True if this course or choice condition accepts concurrent registration ('credit or concurrent registration in ...'); no automatic completion is assumed.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/uiuc-course-advisor/ontology#PrerequisiteCondition"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://example.org/uiuc-course-advisor/ontology#roomNumber">
    <rdfs:label xml:lang="en">roomNumber</rdfs:label>
    <rdfs:comment>Room from the catalog; may be blank.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/uiuc-course-advisor/ontology#Section"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://example.org/uiuc-course-advisor/ontology#conditionSourceText">
    <rdfs:label xml:lang="en">conditionSourceText</rdfs:label>
    <rdfs:comment>Original condition clause for auditability.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/uiuc-course-advisor/ontology#PrerequisiteCondition"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://example.org/uiuc-course-advisor/ontology#hasRequirement">
    <rdfs:label xml:lang="en">hasRequirement</rdfs:label>
    <rdfs:comment>Program includes a core/elective requirement bucket.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/uiuc-course-advisor/ontology#DegreeProgram"/>
    <rdfs:range rdf:resource="https://example.org/uiuc-course-advisor/ontology#DegreeRequirement"/>
    <owl:inverseOf>
      <owl:ObjectProperty rdf:about="https://example.org/uiuc-course-advisor/ontology#belongsToProgram">
        <rdfs:label xml:lang="en">belongsToProgram</rdfs:label>
        <rdfs:comment>Inverse of hasRequirement.</rdfs:comment>
        <rdfs:domain rdf:resource="https://example.org/uiuc-course-advisor/ontology#DegreeRequirement"/>
        <rdfs:range rdf:resource="https://example.org/uiuc-course-advisor/ontology#DegreeProgram"/>
      </owl:ObjectProperty>
    </owl:inverseOf>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://example.org/uiuc-course-advisor/ontology#startTime">
    <rdfs:label xml:lang="en">startTime</rdfs:label>
    <rdfs:comment>Start time as printed (string, because ARRANGED/blank values occur).</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/uiuc-course-advisor/ontology#Section"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://example.org/uiuc-course-advisor/ontology#minCourses">
    <rdfs:label xml:lang="en">minCourses</rdfs:label>
    <rdfs:comment>Minimum courses to allocate to this group, if applicable.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/uiuc-course-advisor/ontology#DegreeRequirement"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://example.org/uiuc-course-advisor/ontology#standingRank">
    <rdfs:label xml:lang="en">standingRank</rdfs:label>
    <rdfs:comment>Standing/year rank. Fixed encoding: 1=Freshman, 2=Sophomore, 3=Junior, 4=Senior, 5=Graduate. A requirement such as "Junior, Senior or Graduate" is stored as minimumStandingRank 3.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/uiuc-course-advisor/ontology#Student"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://example.org/uiuc-course-advisor/ontology#programName">
    <rdfs:label xml:lang="en">programName</rdfs:label>
    <rdfs:comment>Degree title.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/uiuc-course-advisor/ontology#DegreeProgram"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://example.org/uiuc-course-advisor/ontology#taughtBy">
    <rdfs:label xml:lang="en">taughtBy</rdfs:label>
    <rdfs:comment>Instructor(s) listed for a section.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/uiuc-course-advisor/ontology#Section"/>
    <rdfs:range rdf:resource="https://example.org/uiuc-course-advisor/ontology#Instructor"/>
    <owl:inverseOf>
      <owl:ObjectProperty rdf:about="https://example.org/uiuc-course-advisor/ontology#teaches">
        <rdfs:label xml:lang="en">teaches</rdfs:label>
        <rdfs:comment>Inverse of taughtBy.</rdfs:comment>
        <rdfs:domain rdf:resource="https://example.org/uiuc-course-advisor/ontology#Instructor"/>
        <rdfs:range rdf:resource="https://example.org/uiuc-course-advisor/ontology#Section"/>
      </owl:ObjectProperty>
    </owl:inverseOf>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://example.org/uiuc-course-advisor/ontology#hasPlannedEnrollment">
    <rdfs:label xml:lang="en">hasPlannedEnrollment</rdfs:label>
    <rdfs:comment>Student intends to enroll in a term.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/uiuc-course-advisor/ontology#Student"/>
    <rdfs:range rdf:resource="https://example.org/uiuc-course-advisor/ontology#PlannedEnrollment"/>
  </owl:ObjectProperty>
  <owl:Ontology rdf:about="https://example.org/uiuc-course-advisor/ontology">
    <rdfs:label xml:lang="en">University Course Planning and Prerequisite Advisory Ontology</rdfs:label>
    <rdfs:comment xml:lang="en">T-Box schema for course catalogs, nested AND/OR prerequisites, degree requirement groups, course offerings, sections and student evidence. No real UIUC course instances are asserted in this file.</rdfs:comment>
    <rdfs:comment xml:lang="en">Revision 1.3 adds CourseChoiceCondition, the mentionsCourse super-property (requiredCourse, alternativeCourse), the defined class CourseWithPrerequisites and an AllDisjointClasses axiom over the structural classes. It lets catalog prerequisite text of the form 'A or B; one of C, D; E' (an AND of OR-groups) be stored without multiplying it out into many options.</rdfs:comment>
    <owl:versionInfo>1.3 - AI-3001 Iteration 1 final (UIUC BS Computer Science); 2026-11-14</owl:versionInfo>
    <owl:versionIRI rdf:resource="https://example.org/uiuc-course-advisor/ontology/1.3"/>
    <dcterms:creator>Hassan Tariq (24i-2555)</dcterms:creator>
    <dcterms:creator>Afaan Sohail (24i-0081)</dcterms:creator>
    <dcterms:creator>Diya Hurmat (24i-0094)</dcterms:creator>
  </owl:Ontology>
  <owl:DatatypeProperty rdf:about="https://example.org/uiuc-course-advisor/ontology#courseNumber">
    <rdfs:label xml:lang="en">courseNumber</rdfs:label>
    <rdfs:comment>Numeric course number.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/uiuc-course-advisor/ontology#Course"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://example.org/uiuc-course-advisor/ontology#prerequisiteSourceText">
    <rdfs:label xml:lang="en">prerequisiteSourceText</rdfs:label>
    <rdfs:comment>Original prerequisite prose, retained for explanations.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/uiuc-course-advisor/ontology#PrerequisiteExpression"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://example.org/uiuc-course-advisor/ontology#courseCreditsMax">
    <rdfs:label xml:lang="en">courseCreditsMax</rdfs:label>
    <rdfs:comment>Upper bound of credit hours (or fixed value).</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/uiuc-course-advisor/ontology#Course"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://example.org/uiuc-course-advisor/ontology#scheduledInTerm">
    <rdfs:label xml:lang="en">scheduledInTerm</rdfs:label>
    <rdfs:comment>Derived by hasOffering followed by offeredInTerm; historical only for the catalog snapshot.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/uiuc-course-advisor/ontology#Course"/>
    <rdfs:range rdf:resource="https://example.org/uiuc-course-advisor/ontology#AcademicTerm"/>
    <owl:propertyChainAxiom rdf:parseType="Collection">
      <rdf:Description rdf:about="https://example.org/uiuc-course-advisor/ontology#hasOffering"/>
      <rdf:Description rdf:about="https://example.org/uiuc-course-advisor/ontology#offeredInTerm"/>
    </owl:propertyChainAxiom>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://example.org/uiuc-course-advisor/ontology#totalCreditsRequired">
    <rdfs:label xml:lang="en">totalCreditsRequired</rdfs:label>
    <rdfs:comment>Minimum total credit hours required for graduation.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/uiuc-course-advisor/ontology#DegreeProgram"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://example.org/uiuc-course-advisor/ontology#allowsCourse">
    <rdfs:label xml:lang="en">allowsCourse</rdfs:label>
    <rdfs:comment>Course permitted to satisfy requirement, subject to catalog rules.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/uiuc-course-advisor/ontology#DegreeRequirement"/>
    <rdfs:range rdf:resource="https://example.org/uiuc-course-advisor/ontology#Course"/>
    <owl:inverseOf>
      <owl:ObjectProperty rdf:about="https://example.org/uiuc-course-advisor/ontology#maySatisfyRequirement">
        <rdfs:label xml:lang="en">maySatisfyRequirement</rdfs:label>
        <rdfs:comment>Inverse of allowsCourse; eligibility for allocation, not proof of fulfilment.</rdfs:comment>
        <rdfs:domain rdf:resource="https://example.org/uiuc-course-advisor/ontology#Course"/>
        <rdfs:range rdf:resource="https://example.org/uiuc-course-advisor/ontology#DegreeRequirement"/>
      </owl:ObjectProperty>
    </owl:inverseOf>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://example.org/uiuc-course-advisor/ontology#hasDegreeAttribute">
    <rdfs:label xml:lang="en">hasDegreeAttribute</rdfs:label>
    <rdfs:comment>Catalog degree/gen-ed attribute text, preserved verbatim.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/uiuc-course-advisor/ontology#Course"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://example.org/uiuc-course-advisor/ontology#minCredits">
    <rdfs:label xml:lang="en">minCredits</rdfs:label>
    <rdfs:comment>Minimum awarded credits to allocate to this group, if applicable.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/uiuc-course-advisor/ontology#DegreeRequirement"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://example.org/uiuc-course-advisor/ontology#plannedTerm">
    <rdfs:label xml:lang="en">plannedTerm</rdfs:label>
    <rdfs:comment>Term for planned enrollment.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/uiuc-course-advisor/ontology#PlannedEnrollment"/>
    <rdfs:range rdf:resource="https://example.org/uiuc-course-advisor/ontology#AcademicTerm"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://example.org/uiuc-course-advisor/ontology#programCatalogYear">
    <rdfs:label xml:lang="en">programCatalogYear</rdfs:label>
    <rdfs:comment>Year/version to which degree rules apply.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/uiuc-course-advisor/ontology#DegreeProgram"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://example.org/uiuc-course-advisor/ontology#courseCode">
    <rdfs:label xml:lang="en">courseCode</rdfs:label>
    <rdfs:comment>Canonical code, for example CS 225.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/uiuc-course-advisor/ontology#Course"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://example.org/uiuc-course-advisor/ontology#minimumGrade">
    <rdfs:label xml:lang="en">minimumGrade</rdfs:label>
    <rdfs:comment>Raw minimum grade string, if explicit.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/uiuc-course-advisor/ontology#CourseCondition"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://example.org/uiuc-course-advisor/ontology#sourceURL">
    <rdfs:label xml:lang="en">sourceURL</rdfs:label>
    <rdfs:comment>Link to catalog or official degree-program source; provenance property.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://example.org/uiuc-course-advisor/ontology#hasSection">
    <rdfs:label xml:lang="en">hasSection</rdfs:label>
    <rdfs:comment>Section linked to its offering when section data exists.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/uiuc-course-advisor/ontology#CourseOffering"/>
    <rdfs:range rdf:resource="https://example.org/uiuc-course-advisor/ontology#Section"/>
    <owl:inverseOf>
      <owl:ObjectProperty rdf:about="https://example.org/uiuc-course-advisor/ontology#sectionOf">
        <rdfs:label xml:lang="en">sectionOf</rdfs:label>
        <rdfs:comment>Inverse of hasSection.</rdfs:comment>
        <rdfs:domain rdf:resource="https://example.org/uiuc-course-advisor/ontology#Section"/>
        <rdfs:range rdf:resource="https://example.org/uiuc-course-advisor/ontology#CourseOffering"/>
      </owl:ObjectProperty>
    </owl:inverseOf>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://example.org/uiuc-course-advisor/ontology#crossListedWith">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
    <rdfs:label xml:lang="en">crossListedWith</rdfs:label>
    <rdfs:comment>Symmetric Same-as catalog link; does not imply OWL sameAs or transferable credits.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/uiuc-course-advisor/ontology#Course"/>
    <rdfs:range rdf:resource="https://example.org/uiuc-course-advisor/ontology#Course"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://example.org/uiuc-course-advisor/ontology#requirementNote">
    <rdfs:label xml:lang="en">requirementNote</rdfs:label>
    <rdfs:comment>Verbatim or condensed catalog policy for this group (letter-grade rule, caps, substitution, permission, distinct-from-other-group rules) that cannot be reduced to minCourses/minCredits.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/uiuc-course-advisor/ontology#DegreeRequirement"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://example.org/uiuc-course-advisor/ontology#plannedCourse">
    <rdfs:label xml:lang="en">plannedCourse</rdfs:label>
    <rdfs:comment>Course planned but not yet completed.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/uiuc-course-advisor/ontology#PlannedEnrollment"/>
    <rdfs:range rdf:resource="https://example.org/uiuc-course-advisor/ontology#Course"/>
  </owl:ObjectProperty>
  <owl:AllDisjointClasses rdf:nodeID="Nbc162c1a9dc54a26bba7e2db764a84e0">
    <owl:members rdf:parseType="Collection">
      <rdf:Description rdf:about="https://example.org/uiuc-course-advisor/ontology#Course"/>
      <rdf:Description rdf:about="https://example.org/uiuc-course-advisor/ontology#Department"/>
      <rdf:Description rdf:about="https://example.org/uiuc-course-advisor/ontology#AcademicTerm"/>
      <rdf:Description rdf:about="https://example.org/uiuc-course-advisor/ontology#CourseOffering"/>
      <rdf:Description rdf:about="https://example.org/uiuc-course-advisor/ontology#Section"/>
      <rdf:Description rdf:about="https://example.org/uiuc-course-advisor/ontology#DegreeProgram"/>
      <rdf:Description rdf:about="https://example.org/uiuc-course-advisor/ontology#DegreeRequirement"/>
      <rdf:Description rdf:about="https://example.org/uiuc-course-advisor/ontology#PrerequisiteExpression"/>
      <rdf:Description rdf:about="https://example.org/uiuc-course-advisor/ontology#PrerequisiteOption"/>
      <rdf:Description rdf:about="https://example.org/uiuc-course-advisor/ontology#PrerequisiteCondition"/>
      <rdf:Description rdf:about="https://example.org/uiuc-course-advisor/ontology#CourseCompletion"/>
      <rdf:Description rdf:about="https://example.org/uiuc-course-advisor/ontology#PlannedEnrollment"/>
    </owl:members>
  </owl:AllDisjointClasses>
  <owl:DatatypeProperty rdf:about="https://example.org/uiuc-course-advisor/ontology#crn">
    <rdfs:label xml:lang="en">crn</rdfs:label>
    <rdfs:comment>Course registration number if available in a separate section-level source.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/uiuc-course-advisor/ontology#Section"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://example.org/uiuc-course-advisor/ontology#hasCompletedCourse">
    <rdfs:label xml:lang="en">hasCompletedCourse</rdfs:label>
    <rdfs:comment>Derived from a completion record; does not establish passing grade/degree applicability.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/uiuc-course-advisor/ontology#Student"/>
    <rdfs:range rdf:resource="https://example.org/uiuc-course-advisor/ontology#Course"/>
    <owl:propertyChainAxiom rdf:parseType="Collection">
      <rdf:Description rdf:about="https://example.org/uiuc-course-advisor/ontology#hasCompletion"/>
      <rdf:Description rdf:about="https://example.org/uiuc-course-advisor/ontology#completedCourse"/>
    </owl:propertyChainAxiom>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://example.org/uiuc-course-advisor/ontology#termName">
    <rdfs:label xml:lang="en">termName</rdfs:label>
    <rdfs:comment>Fall, Spring, Summer, or Winter.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/uiuc-course-advisor/ontology#AcademicTerm"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://example.org/uiuc-course-advisor/ontology#courseDescription">
    <rdfs:label xml:lang="en">courseDescription</rdfs:label>
    <rdfs:comment>Original human-readable catalog course description.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/uiuc-course-advisor/ontology#Course"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://example.org/uiuc-course-advisor/ontology#courseTitle">
    <rdfs:label xml:lang="en">courseTitle</rdfs:label>
    <rdfs:comment>Catalog course title.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/uiuc-course-advisor/ontology#Course"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://example.org/uiuc-course-advisor/ontology#gradeAwarded">
    <rdfs:label xml:lang="en">gradeAwarded</rdfs:label>
    <rdfs:comment>Grade from transcript, if known.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/uiuc-course-advisor/ontology#CourseCompletion"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://example.org/uiuc-course-advisor/ontology#CourseCondition">
    <rdfs:label xml:lang="en">CourseCondition</rdfs:label>
    <rdfs:comment>A prerequisite course, with optional concurrency flag and grade requirement.</rdfs:comment>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n87de06af1cad4545bb78774e0635c772b9">
        <owl:onClass rdf:resource="https://example.org/uiuc-course-advisor/ontology#Course"/>
        <owl:onProperty rdf:resource="https://example.org/uiuc-course-advisor/ontology#requiredCourse"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n87de06af1cad4545bb78774e0635c772b10">
        <owl:onProperty rdf:resource="https://example.org/uiuc-course-advisor/ontology#requiredCourse"/>
        <owl:someValuesFrom rdf:resource="https://example.org/uiuc-course-advisor/ontology#Course"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="https://example.org/uiuc-course-advisor/ontology#PrerequisiteCondition"/>
    <owl:disjointWith rdf:resource="https://example.org/uiuc-course-advisor/ontology#ConsentCondition"/>
    <owl:disjointWith rdf:resource="https://example.org/uiuc-course-advisor/ontology#OtherCondition"/>
    <owl:disjointWith rdf:resource="https://example.org/uiuc-course-advisor/ontology#StandingCondition"/>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/uiuc-course-advisor/ontology#Student">
    <rdfs:label xml:lang="en">Student</rdfs:label>
    <rdfs:comment>A student whose transcript and permissions are available for planning.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/uiuc-course-advisor/ontology#Department">
    <rdfs:label xml:lang="en">Department</rdfs:label>
    <rdfs:comment>Academic subject or department offering courses.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/uiuc-course-advisor/ontology#Course">
    <rdfs:label xml:lang="en">Course</rdfs:label>
    <rdfs:comment>Unique academic course, not a section or offering. URI is subject plus course number.</rdfs:comment>
    <owl:disjointWith rdf:resource="https://example.org/uiuc-course-advisor/ontology#CourseOffering"/>
    <owl:disjointWith rdf:resource="https://example.org/uiuc-course-advisor/ontology#Section"/>
    <owl:disjointWith rdf:resource="https://example.org/uiuc-course-advisor/ontology#Student"/>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/uiuc-course-advisor/ontology#CourseChoiceCondition">
    <rdfs:label xml:lang="en">CourseChoiceCondition</rdfs:label>
    <rdfs:comment>A prerequisite condition satisfied by ANY ONE of its alternativeCourse values (catalog wording 'A or B' / 'one of A, B, C'). Used inside an option, so an option stays an AND of conditions while each group keeps its OR.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://example.org/uiuc-course-advisor/ontology#PrerequisiteCondition"/>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="N4c61c58c3ee5411b9fc95c343461dd4e">
        <owl:onProperty rdf:resource="https://example.org/uiuc-course-advisor/ontology#alternativeCourse"/>
        <owl:someValuesFrom rdf:resource="https://example.org/uiuc-course-advisor/ontology#Course"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <owl:disjointWith rdf:resource="https://example.org/uiuc-course-advisor/ontology#CourseCondition"/>
    <owl:disjointWith rdf:resource="https://example.org/uiuc-course-advisor/ontology#StandingCondition"/>
    <owl:disjointWith rdf:resource="https://example.org/uiuc-course-advisor/ontology#ConsentCondition"/>
    <owl:disjointWith rdf:resource="https://example.org/uiuc-course-advisor/ontology#OtherCondition"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://example.org/uiuc-course-advisor/ontology#offeredInTerm">
    <rdfs:label xml:lang="en">offeredInTerm</rdfs:label>
    <rdfs:comment>Term in which this offering is observed.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/uiuc-course-advisor/ontology#CourseOffering"/>
    <rdfs:range rdf:resource="https://example.org/uiuc-course-advisor/ontology#AcademicTerm"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://example.org/uiuc-course-advisor/ontology#ConsentCondition">
    <rdfs:label xml:lang="en">ConsentCondition</rdfs:label>
    <rdfs:comment>Permission/consent requirement that must be checked explicitly.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://example.org/uiuc-course-advisor/ontology#PrerequisiteCondition"/>
    <owl:disjointWith rdf:resource="https://example.org/uiuc-course-advisor/ontology#OtherCondition"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://example.org/uiuc-course-advisor/ontology#hasCondition">
    <rdfs:label xml:lang="en">hasCondition</rdfs:label>
    <rdfs:comment>AND: all conditions inside this option must be satisfied.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/uiuc-course-advisor/ontology#PrerequisiteOption"/>
    <rdfs:range rdf:resource="https://example.org/uiuc-course-advisor/ontology#PrerequisiteCondition"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://example.org/uiuc-course-advisor/ontology#requiredCourse">
    <rdfs:label xml:lang="en">requiredCourse</rdfs:label>
    <rdfs:comment>The single course a CourseCondition requires. Sub-property of mentionsCourse.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/uiuc-course-advisor/ontology#CourseCondition"/>
    <rdfs:range rdf:resource="https://example.org/uiuc-course-advisor/ontology#Course"/>
    <rdfs:subPropertyOf>
      <owl:ObjectProperty rdf:about="https://example.org/uiuc-course-advisor/ontology#mentionsCourse">
        <rdfs:label xml:lang="en">mentionsCourse</rdfs:label>
        <rdfs:comment>Any course referenced by a prerequisite condition (required or one alternative). Super-property of requiredCourse and alternativeCourse.</rdfs:comment>
        <rdfs:domain rdf:resource="https://example.org/uiuc-course-advisor/ontology#PrerequisiteCondition"/>
        <rdfs:range rdf:resource="https://example.org/uiuc-course-advisor/ontology#Course"/>
      </owl:ObjectProperty>
    </rdfs:subPropertyOf>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://example.org/uiuc-course-advisor/ontology#completedCourse">
    <rdfs:label xml:lang="en">completedCourse</rdfs:label>
    <rdfs:comment>Course linked to one completion record.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/uiuc-course-advisor/ontology#CourseCompletion"/>
    <rdfs:range rdf:resource="https://example.org/uiuc-course-advisor/ontology#Course"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://example.org/uiuc-course-advisor/ontology#PrerequisiteOption">
    <rdfs:label xml:lang="en">PrerequisiteOption</rdfs:label>
    <rdfs:comment>One permissible alternative: ALL conditions linked by hasCondition must hold (AND).</rdfs:comment>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n87de06af1cad4545bb78774e0635c772b11">
        <owl:onProperty rdf:resource="https://example.org/uiuc-course-advisor/ontology#hasCondition"/>
        <owl:someValuesFrom rdf:resource="https://example.org/uiuc-course-advisor/ontology#PrerequisiteCondition"/>
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://example.org/uiuc-course-advisor/ontology#hasOffering">
    <rdfs:label xml:lang="en">hasOffering</rdfs:label>
    <rdfs:comment>Connects the catalog course to a year/term offering.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/uiuc-course-advisor/ontology#Course"/>
    <rdfs:range rdf:resource="https://example.org/uiuc-course-advisor/ontology#CourseOffering"/>
    <owl:inverseOf>
      <owl:ObjectProperty rdf:about="https://example.org/uiuc-course-advisor/ontology#offeringOf">
        <rdfs:label xml:lang="en">offeringOf</rdfs:label>
        <rdfs:comment>Inverse of hasOffering.</rdfs:comment>
        <rdfs:domain rdf:resource="https://example.org/uiuc-course-advisor/ontology#CourseOffering"/>
        <rdfs:range rdf:resource="https://example.org/uiuc-course-advisor/ontology#Course"/>
      </owl:ObjectProperty>
    </owl:inverseOf>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://example.org/uiuc-course-advisor/ontology#alternativeCourse">
    <rdfs:label xml:lang="en">alternativeCourse</rdfs:label>
    <rdfs:comment>One acceptable course of a CourseChoiceCondition; completing any one satisfies it.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/uiuc-course-advisor/ontology#CourseChoiceCondition"/>
    <rdfs:range rdf:resource="https://example.org/uiuc-course-advisor/ontology#Course"/>
    <rdfs:subPropertyOf rdf:resource="https://example.org/uiuc-course-advisor/ontology#mentionsCourse"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://example.org/uiuc-course-advisor/ontology#CourseOffering">
    <rdfs:label xml:lang="en">CourseOffering</rdfs:label>
    <rdfs:comment>One course offered in one academic term; may have one or more sections if source data allows.</rdfs:comment>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n87de06af1cad4545bb78774e0635c772b15">
        <owl:onClass rdf:resource="https://example.org/uiuc-course-advisor/ontology#Course"/>
        <owl:onProperty rdf:resource="https://example.org/uiuc-course-advisor/ontology#offeringOf"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n87de06af1cad4545bb78774e0635c772b16">
        <owl:onClass rdf:resource="https://example.org/uiuc-course-advisor/ontology#AcademicTerm"/>
        <owl:onProperty rdf:resource="https://example.org/uiuc-course-advisor/ontology#offeredInTerm"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/uiuc-course-advisor/ontology#DegreeProgram">
    <rdfs:label xml:lang="en">DegreeProgram</rdfs:label>
    <rdfs:comment>A declared degree plan and catalog version.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/uiuc-course-advisor/ontology#StandingCondition">
    <rdfs:label xml:lang="en">StandingCondition</rdfs:label>
    <rdfs:comment>A standing/year restriction that cannot be reduced to a course code.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://example.org/uiuc-course-advisor/ontology#PrerequisiteCondition"/>
    <owl:disjointWith rdf:resource="https://example.org/uiuc-course-advisor/ontology#ConsentCondition"/>
    <owl:disjointWith rdf:resource="https://example.org/uiuc-course-advisor/ontology#OtherCondition"/>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/uiuc-course-advisor/ontology#OtherCondition">
    <rdfs:label xml:lang="en">OtherCondition</rdfs:label>
    <rdfs:comment>Any unsupported or free-text condition kept for review rather than silently ignored.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://example.org/uiuc-course-advisor/ontology#PrerequisiteCondition"/>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/uiuc-course-advisor/ontology#DegreeRequirement">
    <rdfs:label xml:lang="en">DegreeRequirement</rdfs:label>
    <rdfs:comment>A requirement bucket/group in a degree program; groups normally all need fulfilment.</rdfs:comment>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n87de06af1cad4545bb78774e0635c772b17">
        <owl:onProperty rdf:resource="https://example.org/uiuc-course-advisor/ontology#belongsToProgram"/>
        <owl:someValuesFrom rdf:resource="https://example.org/uiuc-course-advisor/ontology#DegreeProgram"/>
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://example.org/uiuc-course-advisor/ontology#hasOption">
    <rdfs:label xml:lang="en">hasOption</rdfs:label>
    <rdfs:comment>OR: at least one fully satisfied option is needed.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/uiuc-course-advisor/ontology#PrerequisiteExpression"/>
    <rdfs:range rdf:resource="https://example.org/uiuc-course-advisor/ontology#PrerequisiteOption"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://example.org/uiuc-course-advisor/ontology#PrerequisiteExpression">
    <rdfs:label xml:lang="en">PrerequisiteExpression</rdfs:label>
    <rdfs:comment>Complete prerequisite expression for a course. Its options are OR alternatives.</rdfs:comment>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n87de06af1cad4545bb78774e0635c772b12">
        <owl:onProperty rdf:resource="https://example.org/uiuc-course-advisor/ontology#hasOption"/>
        <owl:someValuesFrom rdf:resource="https://example.org/uiuc-course-advisor/ontology#PrerequisiteOption"/>
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/uiuc-course-advisor/ontology#ElectiveRequirement">
    <rdfs:label xml:lang="en">ElectiveRequirement</rdfs:label>
    <rdfs:comment>A degree requirement for electives chosen from an allowed course set.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://example.org/uiuc-course-advisor/ontology#DegreeRequirement"/>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/uiuc-course-advisor/ontology#CourseCompletion">
    <rdfs:label xml:lang="en">CourseCompletion</rdfs:label>
    <rdfs:comment>Student-specific evidence that a course was completed, optionally with grade and credits.</rdfs:comment>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n87de06af1cad4545bb78774e0635c772b13">
        <owl:onClass rdf:resource="https://example.org/uiuc-course-advisor/ontology#Course"/>
        <owl:onProperty rdf:resource="https://example.org/uiuc-course-advisor/ontology#completedCourse"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n87de06af1cad4545bb78774e0635c772b14">
        <owl:onProperty rdf:resource="https://example.org/uiuc-course-advisor/ontology#completedCourse"/>
        <owl:someValuesFrom rdf:resource="https://example.org/uiuc-course-advisor/ontology#Course"/>
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/uiuc-course-advisor/ontology#PrerequisiteCondition">
    <rdfs:label xml:lang="en">PrerequisiteCondition</rdfs:label>
    <rdfs:comment>Abstract prerequisite condition, specialized into course/standing/consent/other.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/uiuc-course-advisor/ontology#PlannedEnrollment">
    <rdfs:label xml:lang="en">PlannedEnrollment</rdfs:label>
    <rdfs:comment>A proposed course enrollment in a target term, separate from a completed course.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/uiuc-course-advisor/ontology#AcademicTerm">
    <rdfs:label xml:lang="en">AcademicTerm</rdfs:label>
    <rdfs:comment>An academic term with year and season, identified independently of offerings.</rdfs:comment>
    <owl:disjointWith rdf:resource="https://example.org/uiuc-course-advisor/ontology#Course"/>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/uiuc-course-advisor/ontology#Section">
    <rdfs:label xml:lang="en">Section</rdfs:label>
    <rdfs:comment>A section/meeting row of a course offering (catalog CRN + Type). One Section per CRN and meeting type, because a CRN may list several meeting rows. The chosen catalog CSV is section-level, so this class is populated.</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://example.org/uiuc-course-advisor/ontology#hasCompletion">
    <rdfs:label xml:lang="en">hasCompletion</rdfs:label>
    <rdfs:comment>Student has completion/transcript record.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/uiuc-course-advisor/ontology#Student"/>
    <rdfs:range rdf:resource="https://example.org/uiuc-course-advisor/ontology#CourseCompletion"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://example.org/uiuc-course-advisor/ontology#Instructor">
    <rdfs:label xml:lang="en">Instructor</rdfs:label>
    <rdfs:comment>A person who teaches one or more sections; populated from the catalog Instructors column.</rdfs:comment>
  </owl:Class>
</rdf:RDF>
