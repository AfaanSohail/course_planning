    uca:minCourses "3"^^xsd:nonNegativeInteger ;
    uca:requirementNote "At least 3 of the CS technical electives must come from a SINGLE focus area (satisfy at least one of the 8 focus-area groups); the team project course may count as one of them. CS 498 and CS 598 special topics may be included by department approval." ;
    uca:sourceURL "https://catalog.illinois.edu/undergraduate/engineering/computer-science-bs/"^^xsd:anyURI .

<https://example.org/uiuc-course-advisor/resource/requirement/UIUC-BS-CS-2026/Elective-Science> a uca:ElectiveRequirement ;
    rdfs:label "Science elective (one Natural Science & Technology course)" ;
    uca:minCourses "1"^^xsd:nonNegativeInteger ;
    uca:minCredits 3.0 ;
    uca:requirementNote "Must come from the Natural Science & Technology (NST) list, in addition to courses used for General Education, and be allowed for credit by Grainger Engineering. Exceptions: ASTR 100, PHYS 101, PHYS 102, CHEM 101. The NST list is a separate catalog list and is NOT yet loaded: add allowsCourse links from it." ;
    uca:sourceURL "https://catalog.illinois.edu/undergraduate/engineering/computer-science-bs/"^^xsd:anyURI .

