    uca:minCourses "1"^^xsd:nonNegativeInteger ;
    uca:minCredits 2.0 ;
    uca:requirementNote "CS 210 (2 or 3 hours) or CS 211. If CS 211 is chosen it also satisfies the campus Advanced Composition requirement." ;
    uca:sourceURL "https://catalog.illinois.edu/undergraduate/engineering/computer-science-bs/"^^xsd:anyURI .

