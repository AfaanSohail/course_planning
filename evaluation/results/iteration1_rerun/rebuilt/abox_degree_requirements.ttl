<https://example.org/uiuc-course-advisor/resource/requirement/UIUC-BS-CS-2026/Elective-Technical> a uca:ElectiveRequirement ;
    rdfs:label "Technical electives (min 6 courses, 18 hours)" ;
    uca:minCourses "6"^^xsd:nonNegativeInteger ;
    uca:minCredits 18.0 ;
    uca:requirementNote "At least 6 additional technical electives totalling at least 18 credit hours, chosen from CS 397 and CS 400-level courses, not including CS 400, CS 401, CS 402, CS 403 or CS 491. CS 500-level courses only with special permission from the CS Academic Office. CS 397 and CS 499 count with a cumulative maximum of 6 credits as technical electives. One \"CS-like\" course in another department may count as a CS 400-level course with CS Academic Office permission; non-CS technical electives are not considered in focus areas. Allowed courses are generated from catalog data by rule R4." ;
    uca:sourceURL "https://catalog.illinois.edu/undergraduate/engineering/computer-science-bs/"^^xsd:anyURI .

