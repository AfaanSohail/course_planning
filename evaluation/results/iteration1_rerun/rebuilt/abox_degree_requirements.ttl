<https://example.org/uiuc-course-advisor/resource/requirement/UIUC-BS-CS-2026/Elective-Advanced> a uca:ElectiveRequirement ;
    rdfs:label "Advanced electives (min 2 courses, 6 hours)" ;
    uca:minCourses "2"^^xsd:nonNegativeInteger ;
    uca:minCredits 6.0 ;
    uca:requirementNote "At least 2 advanced elective courses (6+ credit hours) taken for a letter grade, distinct from courses used as technical electives, chosen from CS 397 or 400-level courses in ANY area at UIUC. A maximum of 6 credit hours of CS 397 may be used across technical and advanced electives. Allowed courses are generated from catalog data by rule R4." ;
    uca:sourceURL "https://catalog.illinois.edu/undergraduate/engineering/computer-science-bs/"^^xsd:anyURI .

