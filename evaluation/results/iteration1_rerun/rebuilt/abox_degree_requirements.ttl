    uca:minCredits 1.0 ;
    uca:requirementNote "External transfer students take ENG 300 instead." ;
    uca:sourceURL "https://catalog.illinois.edu/undergraduate/engineering/computer-science-bs/"^^xsd:anyURI .

<https://example.org/uiuc-course-advisor/resource/requirement/UIUC-BS-CS-2026/Core-EthicsProfessional> a uca:CoreRequirement ;
