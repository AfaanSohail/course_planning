        <https://example.org/uiuc-course-advisor/resource/course/CS421> ;
    uca:minCourses "11"^^xsd:nonNegativeInteger ;
    uca:minCredits 35.0 ;
    uca:requirementNote "Technical GPA of 2.0 is required for CS and Math courses." ;
    uca:sourceURL "https://catalog.illinois.edu/undergraduate/engineering/computer-science-bs/"^^xsd:anyURI .

<https://example.org/uiuc-course-advisor/resource/requirement/UIUC-BS-CS-2026/Core-CalculusI> a uca:CoreRequirement ;
    rdfs:label "Calculus I: MATH 221 (MATH 220 may be substituted)" ;
    uca:allowsCourse <https://example.org/uiuc-course-advisor/resource/course/MATH220>,
        <https://example.org/uiuc-course-advisor/resource/course/MATH221> ;
    uca:minCourses "1"^^xsd:nonNegativeInteger ;
    uca:minCredits 4.0 ;
    uca:requirementNote "MATH 220 is appropriate for students with no calculus background; 4 of 5 credit hours count toward the degree." ;
    uca:sourceURL "https://catalog.illinois.edu/undergraduate/engineering/computer-science-bs/"^^xsd:anyURI .

<https://example.org/uiuc-course-advisor/resource/requirement/UIUC-BS-CS-2026/Core-ENG100> a uca:CoreRequirement ;
